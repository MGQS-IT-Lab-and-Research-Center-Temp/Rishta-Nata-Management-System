<!--
  APPLICATION LAYER (use-cases / orchestration only — no direct I/O):
  - Services/     implementations of the business use-cases
  - Interfaces/   contracts the Presentation layer consumes
  - Authorization/  stage-based access-control policy primitives
  - Workflow/       DTO payloads for the staged paper-form sections
  - Validators/     FluentValidation rules for section submissions
  - EventHandlers/  domain-event reactions (e.g. revert notifications)
  References Domain (entities/enums) + Infrastructure (EF context, DTOs).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.12" />
  </ItemGroup>
</Project>
