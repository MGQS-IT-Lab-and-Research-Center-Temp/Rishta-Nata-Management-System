@using System.Security.Claims
@{
    var displayName = User?.FindFirst("FullName")?.Value;

    displayName = string.IsNullOrWhiteSpace(displayName)
        ? "President"
        : displayName.Trim();

    var firstName = displayName
        .Split(separator: ' ', StringSplitOptions.RemoveEmptyEntries)
        .FirstOrDefault() ?? "President";

    var profileRole = User?.FindFirst(ClaimTypes.Role)?.Value;

    if (string.IsNullOrWhiteSpace(profileRole))
    {
        profileRole = "Jama'at President";
    }

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string? action = null) =>
        string.Equals(controller, currentController, StringComparison.OrdinalIgnoreCase) &&
        (action is null ||
         string.Equals(action, currentAction, StringComparison.OrdinalIgnoreCase));
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Rishtanata</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Outfit:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>

<body>
    <div class="app-shell">

        <header class="topbar">
            <button class="nav-toggle" id="navToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">
                <i class="bi bi-list"></i>
            </button>

            <a class="brand-area" asp-controller="JamaatPresident" asp-action="Dashboard">
                <div class="brand-icon">
                    <i class="bi bi-building-fill"></i>
                </div>

                <div>
                    <div class="brand-name">Rishtanata</div>
                    <div class="brand-subtitle">President Portal</div>
                </div>
            </a>

            <div class="topbar-spacer"></div>

            <div class="topbar-user">
                <div class="greeting">
                    <span>As-salaamu alaykum,</span>
                    <strong>@firstName</strong>
                </div>

                <div class="header-avatar" title="@displayName">
                    <i class="bi bi-person-fill"></i>
                </div>
            </div>
        </header>

        <div class="app-body">

            <aside class="sidebar" id="sidebar">
                <div class="profile-block">
                    <div class="sidebar-avatar" title="@displayName">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div>
                        <div class="profile-name">@displayName</div>
                        <div class="profile-role">@profileRole</div>
                    </div>
                </div>

                <nav class="sidebar-nav" aria-label="Main navigation">
                    <a class="nav-item @(IsActive("JamaatPresident", "Dashboard") ? "active" : "")"
                       asp-controller="JamaatPresident"
                       asp-action="Dashboard">
                        <i class="bi bi-grid-fill"></i>
                        <span>Dashboard</span>
                    </a>

                    <a class="nav-item @(IsActive("JamaatPresident", "PendingApplications") ? "active" : "")"
                       asp-controller="JamaatPresident"
                       asp-action="PendingApplications">
                        <i class="bi bi-inbox"></i>
                        <span>Pending Reviews</span>
                    </a>

                    <a class="nav-item @(IsActive("JamaatPresident", "ReviewedApplications") ? "active" : "")"
                       asp-controller="JamaatPresident"
                       asp-action="ReviewedApplications">
                        <i class="bi bi-check2-circle"></i>
                        <span>Reviewed Applications</span>
                    </a>

                    <a class="nav-item @(IsActive("JamaatPresident", "Certificates") ? "active" : "")"
                       asp-controller="JamaatPresident"
                       asp-action="Certificates">
                        <i class="bi bi-award"></i>
                        <span>Marriage Certificates</span>
                    </a>
                </nav>

                <div class="sidebar-bottom">
                    <form class="logout-form"
                          asp-controller="Auth"
                          asp-action="Logout"
                          method="post">
                        <button type="submit" class="nav-item">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </aside>

            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

            <main class="main-content">
                @RenderBody()
            </main>
        </div>

        <footer class="app-footer">
            <span>
                &copy; @DateTime.Now.Year Rishtanata Management System. All rights reserved.
            </span>

            <span class="footer-mark">
                <i class="bi bi-stars"></i>
                <i class="bi bi-three-dots"></i>
            </span>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
