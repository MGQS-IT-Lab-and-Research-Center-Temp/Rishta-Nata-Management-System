@model Presentation.ViewModels.JamaatPresidentDashboardViewModel

@{
    ViewData["Title"] = "Jamaat President Dashboard";
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">
        <h1 class="fw-bold">Jamaat President Dashboard</h1>

        <p class="text-muted mb-1">
            Welcome, <strong>@Model.PresidentName</strong>
        </p>

        <p class="text-muted">
            @Model.JamaatName • @Model.CircuitName Circuit
        </p>
    </div>


    <!-- Statistics -->
    <div class="row g-4 mb-5">

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Pending Nikah Reviews
                    </h6>

                    <h2 class="fw-bold text-warning">
                        @Model.PendingNikahReviews
                    </h2>

                    <p class="mb-0 text-muted">
                        Applications awaiting your review
                    </p>
                </div>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Reviewed Today
                    </h6>

                    <h2 class="fw-bold text-success">
                        @Model.ReviewedToday
                    </h2>

                    <p class="mb-0 text-muted">
                        Applications reviewed today
                    </p>
                </div>
            </div>
        </div>


        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">
                        Total Applications
                    </h6>

                    <h2 class="fw-bold">
                        @Model.TotalNikahApplications
                    </h2>

                    <p class="mb-0 text-muted">
                        Total Nikah applications
                    </p>
                </div>
            </div>
        </div>

    </div>


    <!-- Pending Nikah Applications -->
    <div class="card shadow-sm border-0 mb-5">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h4 class="mb-1">
                        Nikah Applications Awaiting Review
                    </h4>

                    <small class="text-muted">
                        Review these applications before they proceed
                        to other administrators.
                    </small>
                </div>

                <span class="badge bg-warning text-dark">
                    @Model.PendingNikahReviews Pending
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Groom</th>
                            <th>Bride</th>
                            <th>Jamaat</th>
                            <th>Submitted</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var application in Model.PendingApplications)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @application.GroomName
                                    </strong>
                                </td>

                                <td>
                                    @application.BrideName
                                </td>

                                <td>
                                    @application.JamaatName
                                </td>

                                <td>
                                    @application.SubmittedDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <span class="badge bg-warning text-dark">
                                        @application.Status
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="JamaatPresident" asp-action="Review" asp-route-id="@application.Id"
                                       class="btn btn-primary btn-sm">
                                        Review
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- Review Workflow -->
    <div class="card shadow-sm border-0 mb-5">

        <div class="card-body">

            <h4 class="mb-2">
                Nikah Review Workflow
            </h4>

            <p class="text-muted mb-4">
                The Jamaat President performs the first review
                before the application proceeds to other administrators.
            </p>


            <div class="row text-center">

                <div class="col-md-3 mb-3">
                    <div class="border rounded p-3 h-100">
                        <h5>1</h5>
                        <strong>Application Submitted</strong>
                        <p class="small text-muted mt-2">
                            Applicant submits the Nikah form.
                        </p>
                    </div>
                </div>


                <div class="col-md-3 mb-3">
                    <div class="border border-primary rounded p-3 h-100">
                        <h5 class="text-primary">2</h5>
                        <strong>Jamaat President Review</strong>
                        <p class="small text-muted mt-2">
                            President reviews the application.
                        </p>
                    </div>
                </div>


                <div class="col-md-3 mb-3">
                    <div class="border rounded p-3 h-100">
                        <h5>3</h5>
                        <strong>Admin Review</strong>
                        <p class="small text-muted mt-2">
                            Application proceeds to administrators.
                        </p>
                    </div>
                </div>


                <div class="col-md-3 mb-3">
                    <div class="border rounded p-3 h-100">
                        <h5>4</h5>
                        <strong>Final Approval</strong>
                        <p class="small text-muted mt-2">
                            Application completes the process.
                        </p>
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- Recent Activity -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <h4 class="mb-3">
                Recent Activity
            </h4>

            @foreach (var activity in Model.RecentActivities)
            {
                <div class="border-bottom py-3">

                    <strong>
                        @activity.Description
                    </strong>

                    <div class="text-muted small mt-1">
                        @activity.Date.ToString("dd MMM yyyy, hh:mm tt")
                    </div>

                </div>
            }

        </div>

    </div>

</div>