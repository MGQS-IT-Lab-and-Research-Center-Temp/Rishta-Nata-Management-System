@model Presentation.Models.NikahApplicationViewModel

@{
    ViewData["Title"] = "Review Nikah Application";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <a asp-controller="JamaatPresident" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm mb-3">
            ← Back to Dashboard
        </a>

        <h1 class="fw-bold">Review Nikah Application</h1>

        <p class="text-muted">
            Review the application carefully before forwarding it
            to the other administrators.
        </p>
    </div>


    <!-- Application Status -->
    <div class="alert alert-warning mb-4">
        <strong>Pending President Review</strong>
        <br />
        This application is currently awaiting review by the Jamaat President.
    </div>


    <!-- Application Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">
            <h4 class="mb-0">Application Information</h4>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="text-muted small">
                        Application ID
                    </label>

                    <div class="fw-bold">
                        #@Model.Id
                    </div>
                </div>


                <div class="col-md-6">
                    <label class="text-muted small">
                        Application Status
                    </label>

                    <div>
                        <span class="badge bg-warning text-dark">
                            @Model.Status
                        </span>
                    </div>
                </div>


                <div class="col-md-6">
                    <label class="text-muted small">
                        Date Submitted
                    </label>

                    <div class="fw-bold">
                        @Model.SubmittedDate.ToString("dd MMMM yyyy")
                    </div>
                </div>


                <div class="col-md-6">
                    <label class="text-muted small">
                        Jamaat
                    </label>

                    <div class="fw-bold">
                        @Model.JamaatName
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- Groom & Bride -->
    <div class="row g-4 mb-4">

        <!-- Groom -->
        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white py-3">
                    <h4 class="mb-0">Groom Information</h4>
                </div>

                <div class="card-body">

                    <label class="text-muted small">
                        Full Name
                    </label>

                    <h5 class="fw-bold">
                        @Model.GroomName
                    </h5>

                </div>

            </div>

        </div>


        <!-- Bride -->
        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white py-3">
                    <h4 class="mb-0">Bride Information</h4>
                </div>

                <div class="card-body">

                    <label class="text-muted small">
                        Full Name
                    </label>

                    <h5 class="fw-bold">
                        @Model.BrideName
                    </h5>

                </div>

            </div>

        </div>

    </div>


    <!-- President Decision -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">
            <h4 class="mb-1">President's Decision</h4>

            <small class="text-muted">
                Select the appropriate action after reviewing the application.
            </small>
        </div>

        <div class="card-body">

            <div class="d-flex gap-2 flex-wrap">
                <form asp-controller="JamaatPresident" asp-action="Approve" method="post" class="d-inline">

                    <input type="hidden" name="id" value="@Model.Id" />

                    <button type="submit" class="btn btn-success">
                        ✓ Approve & Forward to Admin
                    </button>

                </form>


                <form asp-controller="JamaatPresident" asp-action="Reject" method="post" class="d-inline">

                    <input type="hidden" name="id" value="@Model.Id" />

                    <button type="submit" class="btn btn-danger">
                        ✕ Reject Application
                    </button>

                </form>


                <form asp-controller="JamaatPresident" asp-action="RequestMoreInformation" method="post"
                      class="d-inline">

                    <input type="hidden" name="id" value="@Model.Id" />

                    <button type="submit" class="btn btn-warning">
                        ! Request More Information
                    </button>

                </form>

            </div>

        </div>

    </div>


    <!-- Review Process -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h4 class="mb-3">
                Current Review Process
            </h4>

            <div class="row text-center">

                <div class="col-md-3 mb-3">
                    <div class="border rounded p-3">
                        <strong>Application Submitted</strong>
                        <div class="text-success mt-2">
                            ✓ Completed
                        </div>
                    </div>
                </div>


                <div class="col-md-3 mb-3">
                    <div class="border border-primary rounded p-3">
                        <strong>President Review</strong>
                        <div class="text-primary mt-2">
                            ● Current
                        </div>
                    </div>
                </div>


                <div class="col-md-3 mb-3">
                    <div class="border rounded p-3">
                        <strong>Admin Review</strong>
                        <div class="text-muted mt-2">
                            Pending
                        </div>
                    </div>
                </div>


                <div class="col-md-3 mb-3">
                    <div class="border rounded p-3">
                        <strong>Final Approval</strong>
                        <div class="text-muted mt-2">
                            Pending
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>