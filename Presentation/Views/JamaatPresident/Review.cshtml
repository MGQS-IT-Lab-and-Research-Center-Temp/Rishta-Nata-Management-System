@model Presentation.ViewModels.JamaatPresidentReviewViewModel

@{
    ViewData["Title"] = "Review Nikah Application";
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">

        <a asp-controller="JamaatPresident"
           asp-action="Dashboard"
           class="btn btn-outline-secondary btn-sm mb-3">
            ← Back to Dashboard
        </a>

        <h1 class="fw-bold">
            Review Nikah Application
        </h1>

        <p class="text-muted mb-0">
            Carefully review all information before making a decision.
        </p>

    </div>


    <!-- Status -->
    <div class="alert alert-warning">

        <strong>
            Jama'at President Review
        </strong>

        <br />

        Current Status:
        <strong>
            @Model.Status
        </strong>

    </div>


    <!-- Application Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h4 class="mb-0">
                Application Information
            </h4>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <small class="text-muted">
                        Reference Number
                    </small>

                    <div class="fw-bold">
                        @Model.ReferenceNumber
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Application ID
                    </small>

                    <div class="fw-bold text-break">
                        @Model.Id
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Date Submitted
                    </small>

                    <div class="fw-bold">
                        @Model.SubmittedDate.ToString("dd MMMM yyyy, hh:mm tt")
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Proposed Nikah Date
                    </small>

                    <div class="fw-bold">
                        @Model.ProposedNikahDate.ToString("dd MMMM yyyy")
                    </div>
                </div>


                <div class="col-md-12">
                    <small class="text-muted">
                        Venue / Jama'at
                    </small>

                    <div class="fw-bold">
                        @Model.Venue
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- Bride -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h4 class="mb-0">
                Bride Information
            </h4>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <small class="text-muted">
                        Full Name
                    </small>

                    <div class="fw-bold">
                        @Model.BrideName
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Membership Number
                    </small>

                    <div class="fw-bold">
                        @Model.BrideMembershipNo
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Date of Birth
                    </small>

                    <div>
                        @Model.BrideDateOfBirth.ToString("dd MMMM yyyy")
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Resident Of
                    </small>

                    <div>
                        @Model.BrideResidentOf
                    </div>
                </div>


                <div class="col-md-4">
                    <small class="text-muted">
                        Genotype
                    </small>

                    <div>
                        @Model.BrideGenotype
                    </div>
                </div>


                <div class="col-md-4">
                    <small class="text-muted">
                        Blood Group
                    </small>

                    <div>
                        @Model.BrideBloodGroup
                    </div>
                </div>


                <div class="col-md-4">
                    <small class="text-muted">
                        Marital Status
                    </small>

                    <div>
                        @Model.BrideMaritalStatus
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Proposed Dower
                    </small>

                    <div class="fw-bold">
                        @Model.BrideProposedDowerAmount.ToString("N2")
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Dower Received in Cash
                    </small>

                    <div class="fw-bold">
                        @Model.BrideDowerAmountReceivedInCash.ToString("N2")
                    </div>
                </div>


                <div class="col-md-12">
                    <small class="text-muted">
                        Signature Telephone
                    </small>

                    <div>
                        @Model.BrideSignatureTel
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- Bridegroom -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h4 class="mb-0">
                Bridegroom Information
            </h4>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <small class="text-muted">
                        Full Name
                    </small>

                    <div class="fw-bold">
                        @Model.BridegroomName
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Membership Number
                    </small>

                    <div class="fw-bold">
                        @Model.BridegroomMembershipNo
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Date of Birth
                    </small>

                    <div>
                        @Model.BridegroomDateOfBirth.ToString("dd MMMM yyyy")
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Resident Of
                    </small>

                    <div>
                        @Model.BridegroomResidentOf
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Genotype
                    </small>

                    <div>
                        @Model.BridegroomGenotype
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Blood Group
                    </small>

                    <div>
                        @Model.BridegroomBloodGroup
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Dower Paid in Cash
                    </small>

                    <div class="fw-bold">
                        @Model.BridegroomDowerAmountPaidInCash.ToString("N2")
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Dower Yet to be Paid
                    </small>

                    <div class="fw-bold">
                        @Model.BridegroomDowerAmountToBePaid.ToString("N2")
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- Previous Nikah Information -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h4 class="mb-0">
                Bridegroom Nikah History
            </h4>
        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-6">
                    <strong>First Nikah:</strong>

                    @if (Model.IsFirstNikah)
                    {
                        <span class="badge bg-success ms-2">
                            Yes
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-2">
                            No
                        </span>
                    }
                </div>


                <div class="col-md-6">
                    <strong>Second / Third / Fourth Nikah:</strong>

                    @if (Model.IsSecondThirdOrFourthNikah)
                    {
                        <span class="badge bg-warning text-dark ms-2">
                            Yes
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-2">
                            No
                        </span>
                    }
                </div>


                <div class="col-md-6">
                    <strong>Former Wife Deceased:</strong>

                    @if (Model.FormerWifeIsDead)
                    {
                        <span class="badge bg-info ms-2">
                            Yes
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-2">
                            No
                        </span>
                    }
                </div>


                <div class="col-md-6">
                    <strong>Former Wife Divorced:</strong>

                    @if (Model.HasDivorcedFormerWife)
                    {
                        <span class="badge bg-info ms-2">
                            Yes
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-2">
                            No
                        </span>
                    }
                </div>


                <div class="col-md-6">
                    <strong>Former Wife Present:</strong>

                    @if (Model.FormerWifeIsPresent)
                    {
                        <span class="badge bg-warning text-dark ms-2">
                            Yes
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-2">
                            No
                        </span>
                    }
                </div>


                <div class="col-md-6">
                    <strong>Former Wife Obtained Khula:</strong>

                    @if (Model.FormerWifeObtainedKhula)
                    {
                        <span class="badge bg-info ms-2">
                            Yes
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-2">
                            No
                        </span>
                    }
                </div>

            </div>

        </div>

    </div>


    <!-- Parents -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h4 class="mb-0">
                Parents
            </h4>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <small class="text-muted">
                        Bride's Father
                    </small>

                    <div class="fw-bold">
                        @Model.BrideFatherName
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Bridegroom's Father
                    </small>

                    <div class="fw-bold">
                        @Model.BridegroomFatherName
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- Guardian -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h4 class="mb-0">
                Guardian / Waliyy
            </h4>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <small class="text-muted">
                        Name
                    </small>

                    <div class="fw-bold">
                        @Model.GuardianName
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Relationship to Bride
                    </small>

                    <div>
                        @Model.GuardianRelationToBride
                    </div>
                </div>


                <div class="col-md-8">
                    <small class="text-muted">
                        Address
                    </small>

                    <div>
                        @Model.GuardianAddress
                    </div>
                </div>


                <div class="col-md-4">
                    <small class="text-muted">
                        Telephone
                    </small>

                    <div>
                        @Model.GuardianTel
                    </div>
                </div>


                <div class="col-md-12">
                    <small class="text-muted">
                        Signature Date
                    </small>

                    <div>
                        @Model.GuardianSignatureDate
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- Representative -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h4 class="mb-0">
                Representative / Wakeel
            </h4>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <small class="text-muted">
                        Name
                    </small>

                    <div class="fw-bold">
                        @Model.RepresentativeName
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Acting For
                    </small>

                    <div>
                        @Model.RepresentativeActingFor
                    </div>
                </div>


                <div class="col-md-12">
                    <small class="text-muted">
                        Address
                    </small>

                    <div>
                        @Model.RepresentativeAddress
                    </div>
                </div>


                <div class="col-md-12">
                    <small class="text-muted">
                        Signature Date
                    </small>

                    <div>
                        @Model.RepresentativeSignatureDate
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- Witnesses -->
    <div class="row g-4 mb-4">

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">
                    <h4 class="mb-0">
                        Witness One
                    </h4>
                </div>

                <div class="card-body">

                    <p>
                        <small class="text-muted">
                            Name
                        </small>
                        <br />
                        <strong>
                            @Model.WitnessOneName
                        </strong>
                    </p>

                    <p>
                        <small class="text-muted">
                            Address
                        </small>
                        <br />
                        @Model.WitnessOneAddress
                    </p>

                    <p>
                        <small class="text-muted">
                            Telephone
                        </small>
                        <br />
                        @Model.WitnessOneTel
                    </p>

                    <p class="mb-0">
                        <small class="text-muted">
                            Signature Date
                        </small>
                        <br />
                        @Model.WitnessOneSignatureDate
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">
                    <h4 class="mb-0">
                        Witness Two
                    </h4>
                </div>

                <div class="card-body">

                    <p>
                        <small class="text-muted">
                            Name
                        </small>
                        <br />
                        <strong>
                            @Model.WitnessTwoName
                        </strong>
                    </p>

                    <p>
                        <small class="text-muted">
                            Address
                        </small>
                        <br />
                        @Model.WitnessTwoAddress
                    </p>

                    <p>
                        <small class="text-muted">
                            Telephone
                        </small>
                        <br />
                        @Model.WitnessTwoTel
                    </p>

                    <p class="mb-0">
                        <small class="text-muted">
                            Signature Date
                        </small>
                        <br />
                        @Model.WitnessTwoSignatureDate
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- Verification -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h4 class="mb-0">
                Verification
            </h4>
        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-6">
                    <small class="text-muted">
                        Officiating Imam
                    </small>

                    <div class="fw-bold">
                        @Model.OfficiatingImamName
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Imam's Jama'at / Address
                    </small>

                    <div>
                        @Model.OfficiatingImamAddressJamaat
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Imam Signature Date
                    </small>

                    <div>
                        @Model.OfficiatingImamSignatureDate
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        Jama'at President
                    </small>

                    <div class="fw-bold">
                        @Model.JamaatPresidentName
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        President Signature Date
                    </small>

                    <div>
                        @Model.JamaatPresidentSignatureDate
                    </div>
                </div>


                <div class="col-md-6">
                    <small class="text-muted">
                        National Rishtanata Secretary
                    </small>

                    <div class="fw-bold">
                        @Model.NationalRishtanataSecretaryName
                    </div>
                </div>

            </div>

        </div>

    </div>


    <!-- President Decision -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <h4 class="mb-1">
                Jama'at President Decision
            </h4>

            <small class="text-muted">
                Make your decision after reviewing the complete application.
            </small>

        </div>


        <div class="card-body">

            <div class="d-flex gap-2 flex-wrap">

                <!-- APPROVE -->
                <form asp-controller="JamaatPresident"
                      asp-action="Approve"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-success"
                            onclick="return confirm('Are you sure you want to approve this application?');">

                        ✓ Approve & Forward

                    </button>

                </form>


                <!-- REJECT -->
                <form asp-controller="JamaatPresident"
                      asp-action="Reject"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-danger"
                            onclick="return confirm('Are you sure you want to reject this application?');">

                        ✕ Reject Application

                    </button>

                </form>


                <!-- MORE INFORMATION -->
                <form asp-controller="JamaatPresident"
                      asp-action="RequestMoreInformation"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button type="submit"
                            class="btn btn-warning"
                            onclick="return confirm('Request additional information for this application?');">

                        ! Request More Information

                    </button>

                </form>

            </div>

        </div>

    </div>


    <!-- Workflow -->
    <div class="card shadow-sm border-0 mb-5">

        <div class="card-body">

            <h4 class="mb-3">
                Nikah Review Workflow
            </h4>


            <div class="row text-center">

                <div class="col-md-3 mb-3">

                    <div class="border rounded p-3 h-100">

                        <strong>
                            Application Submitted
                        </strong>

                        <div class="text-success mt-2">
                            ✓ Completed
                        </div>

                    </div>

                </div>


                <div class="col-md-3 mb-3">

                    <div class="border border-primary rounded p-3 h-100">

                        <strong>
                            Jama'at President Review
                        </strong>

                        <div class="text-primary mt-2">
                            ● Current
                        </div>

                    </div>

                </div>


                <div class="col-md-3 mb-3">

                    <div class="border rounded p-3 h-100">

                        <strong>
                            National Rishtanata Secretary
                        </strong>

                        <div class="text-muted mt-2">
                            Pending
                        </div>

                    </div>

                </div>


                <div class="col-md-3 mb-3">

                    <div class="border rounded p-3 h-100">

                        <strong>
                            Final Approval
                        </strong>

                        <div class="text-muted mt-2">
                            Pending
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>