@model Presentation.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Login - Rishta Nata Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/Login.css">
</head>

<body>

    <div class="container">
        <div class="row justify-content-center align-items-center login-wrapper">

            <div class="col-12">

                <div class="card login-card shadow mx-auto">

                    <div class="card-body p-4 p-md-5">

                        <!-- Logo -->
                        <div class="text-center">
                            <div class="logo-circle">
                                <img src="~/img/logo.png"
                                     alt="Rishta Nata logo" />
                            </div>

                            <h2 class="fw-bold mb-2">
                                Welcome Back
                            </h2>

                            <p class="text-muted mb-4">
                                Login to your Rishta Nata account
                            </p>
                        </div>

                        <!-- Login Form -->
                        <form asp-controller="Auth"
                              asp-action="Login"
                              method="post">

                            @Html.AntiForgeryToken()

                            <!-- Validation Errors -->
                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>

                            <!-- Email -->
                            <div class="mb-3">
                                <label asp-for="Email"
                                       class="form-label fw-semibold">
                                    Email Address
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control form-control-lg"
                                       placeholder="Enter your email"
                                       autocomplete="email" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Password -->
                            <div class="mb-3">
                                <label asp-for="Password"
                                       class="form-label fw-semibold">
                                    Password
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control form-control-lg"
                                       placeholder="Enter your password"
                                       autocomplete="current-password" />

                                <span asp-validation-for="Password"
                                      class="text-danger">
                                </span>
                            </div>

                            <!-- Remember + Forgot -->
                            <div class="d-flex justify-content-between align-items-center mb-4">

                                <div class="form-check">
                                    <input asp-for="RememberMe"
                                           class="form-check-input" />

                                    <label asp-for="RememberMe"
                                           class="form-check-label">
                                        Remember me
                                    </label>
                                </div>

                                <a href="#"
                                   class="text-success text-decoration-none">
                                    Forgot Password?
                                </a>

                        <div class="mb-3">
                            <label for="password" class="form-label fw-semibold">
                                Password
                            </label>

                            <input
                                type="password"
                                class="form-control form-control-lg"
                                id="password"
                                name="Password"
                                placeholder="Enter your password"
                                required>
                        </div>

                            <!-- Return URL -->
                            @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                            {
                                <input type="hidden"
                                       asp-for="ReturnUrl" />
                            }

                            <!-- Login Button -->
                            <div class="d-grid">
                                <button type="submit"
                                        class="btn btn-success btn-lg login-button">
                                    Login
                                </button>
                            </div>

                    </form>

                        <!-- Register -->
                        <div class="text-center mt-4">

                            <p class="text-muted mb-0">
                                Don't have an account?
                                <a href="#"
                                   class="text-success fw-semibold text-decoration-none">
                                    Create an account
                                </a>
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>