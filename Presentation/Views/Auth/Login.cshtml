@model Presentation.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Login - Rishta Nata Management System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/Login.css"
          asp-append-version="true" />
</head>

<body>

    <main class="login-page">

        <!-- LEFT SIDE -->
        <section class="login-hero">

            <div class="hero-content">

                <div class="brand">

                    <div class="brand-logo">
                        <img src="~/img/logo.png"
                             alt="Rishta Nata logo" />
                    </div>

                    <span>Rishta Nata</span>

                </div>

                <div class="hero-text">

                    <h1>
                        Connect.
                        <br />
                        Build.
                        <br />
                        <span>Grow together.</span>
                    </h1>

                    <p>
                        Welcome to the Rishta Nata Management System.
                        Manage your profile, connect with the community,
                        and build meaningful relationships.
                    </p>

                </div>

                <div class="hero-decoration decoration-one"></div>
                <div class="hero-decoration decoration-two"></div>
                <div class="hero-decoration decoration-three"></div>

            </div>

        </section>


        <!-- RIGHT SIDE -->
        <section class="login-section">

            <div class="login-container">

                <!-- LOGIN HEADER -->
                <div class="login-header">

                    <!-- RIGHT-SIDE LOGO -->
                    <div class="login-logo">
                        <img src="~/img/logo.png"
                             alt="Rishta Nata logo" />
                    </div>

                    <h2>
                        Welcome Back
                    </h2>

                    <p>
                        Login to your Rishta Nata account
                    </p>

                </div>


                <!-- LOGIN FORM -->
                <form asp-controller="Auth"
                      asp-action="Login"
                      method="post"
                      class="login-form">

                    @Html.AntiForgeryToken()


                    <!-- VALIDATION SUMMARY -->
                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary">
                    </div>


                    <!-- CHANDA NUMBER -->
                    <div class="form-group">

                        <label asp-for="ChandaNo">
                            Member Chanda Number
                        </label>

                        <input asp-for="ChandaNo"
                               type="text"
                               class="login-input"
                               placeholder="Enter your Chanda number"
                               autocomplete="off"
                               inputmode="numeric"
                               autofocus />

                        <span asp-validation-for="ChandaNo"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- PASSWORD -->
                    <div class="form-group">

                        <div class="password-label-row">

                            <label asp-for="Password">
                                Password
                            </label>

                            <a href="#"
                               class="forgot-password">
                                Forgot Password?
                            </a>

                        </div>

                        <input asp-for="Password"
                               type="password"
                               class="login-input"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                        <span asp-validation-for="Password"
                              class="field-validation">
                        </span>

                    </div>


                    <!-- REMEMBER ME -->
                    <div class="remember-row">

                        <label class="remember-label">

                            <input asp-for="RememberMe"
                                   type="checkbox" />

                            <span>
                                Remember me
                            </span>

                        </label>

                    </div>


                    <!-- RETURN URL -->
                    @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                    {
                        <input type="hidden"
                               asp-for="ReturnUrl" />
                    }


                    <!-- LOGIN BUTTON -->
                    <button type="submit"
                            class="login-button">
                        Login
                    </button>

                </form>


                <!-- DIVIDER -->
                <div class="divider">

                    <span></span>

                    <p>OR</p>

                    <span></span>

                </div>


                <!-- REGISTER -->
                <div class="register-section">

                    <p>
                        Don't have an account?
                    </p>

                    <a href="#"
                       class="register-button">
                        Create an account
                    </a>

                </div>

            </div>

        </section>

    </main>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>