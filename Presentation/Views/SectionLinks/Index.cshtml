@model Presentation.ViewModels.SectionLinksViewModel
@{
    ViewData["Title"] = "Signature Links";
    var error = TempData["Error"] as string;
    var signatureWaitActive = Model.FormStage == Domain.Enums.MarriageFormStage.AwaitingWitnesses;
}

<div class="dashboard-hero">
    <h1>Signature Links</h1>
    <p>Application <strong>@Model.ReferenceNumber</strong>
       (@Model.BrideName &#x2764; @Model.BridegroomName) — awaiting signatures.</p>
</div>

@if (!signatureWaitActive)
{
    <div class="alert alert-secondary">
        Signatures are no longer being collected for this application (current stage:
        @Model.FormStage). Existing links are inactive.
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-warning">@error</div>
}

<div class="card dashboard-card">
    <div class="card-header">Links</div>
    <div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Section</th>
                    <th>Status</th>
                    <th>Filled by</th>
                    <th>Link</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><strong>@SectionTitle(item.Section)</strong></td>
                    <td>
                        @if (item.Complete) { <span class="text-success">Completed</span> }
                        else if (item.HasActiveToken) { <span class="text-warning">Link active</span> }
                        else { <span class="text-muted">No link</span> }
                    </td>
                    <td>@(item.FilledByName ?? "—")</td>
                    <td>
                        @if (signatureWaitActive && !string.IsNullOrWhiteSpace(item.RawToken))
                        {
                            var url = Url.Action("Fill", "SharedSection", new { token = item.RawToken }, Context.Request.Scheme)!;
                            <div class="input-group input-group-sm">
                                <input class="form-control form-control-sm" value="@url" readonly aria-label="Signature link" />
                                <button type="button" class="btn btn-outline-primary" onclick="copyLink(this)">Copy</button>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-end">
                        @if (signatureWaitActive)
                        {
                            @if (item.HasActiveToken)
                            {
                                <form asp-action="Revoke" asp-controller="SectionLinks" method="post" class="d-inline">
                                    <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                                    <input type="hidden" name="section" value="@item.Section" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                                </form>
                                <form asp-action="Regenerate" asp-controller="SectionLinks" method="post" class="d-inline ms-1">
                                    <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                                    <input type="hidden" name="section" value="@item.Section" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Regenerate</button>
                                </form>
                            }
                            else if (!item.Complete)
                            {
                                <form asp-action="Generate" asp-controller="SectionLinks" method="post" class="d-inline">
                                    <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                                    <input type="hidden" name="section" value="@item.Section" />
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-primary">Get link</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<script>
    function copyLink(btn) {
        const input = btn.closest('.input-group').querySelector('input');
        input.select();
        document.execCommand('copy');
        btn.textContent = 'Copied';
        setTimeout(function () { btn.textContent = 'Copy'; }, 1500);
    }
</script>

@functions {
    private static string SectionTitle(Domain.Enums.SectionType s) => s switch
    {
        Domain.Enums.SectionType.Guardian => "Guardian / Waliy",
        Domain.Enums.SectionType.WitnessOne => "Witness 1",
        Domain.Enums.SectionType.WitnessTwo => "Witness 2",
        _ => s.ToString()
    };
}