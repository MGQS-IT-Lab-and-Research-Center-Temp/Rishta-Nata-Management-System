@page
@model IEnumerable<Presentation.ViewModels.JamaatMember.JamaatMemberVM>

@{
    ViewData["Title"] = "Jama'at Members";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Jama'at Members
            </h2>

            <p class="text-muted mb-0">
                View registered members across all Jama'ats.
            </p>

        </div>

        <a asp-controller="RishtanataSecretary"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">

            ← Dashboard

        </a>

    </div>

    <!-- Search & Filters -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <input type="text"
                           class="form-control"
                           placeholder="Search by Name or Member Number..." />

                </div>

                <div class="col-md-3">

                    <select class="form-select">

                        <option>All Jama'ats</option>
                        <option>Kano Central</option>
                        <option>Kaduna North</option>
                        <option>Abuja Central</option>
                        <option>Ibadan West</option>

                    </select>

                </div>

                <div class="col-md-3">

                    <select class="form-select">

                        <option>All Marital Status</option>
                        <option>Single</option>
                        <option>Married</option>
                        <option>Divorced</option>
                        <option>Widowed</option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button class="btn btn-primary w-100">

                        Search

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Members Table -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h4 class="mb-1">

                        Registered Members

                    </h4>

                    <small class="text-muted">

                        List of all registered Jama'at members.

                    </small>

                </div>

                <span class="badge bg-primary fs-6">

                    @Model.Count() Members

                </span>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Chanda No.</th>

                        <th>Full Name</th>

                        <th>Sex</th>

                        <th>Jamaat Member</th>

                        <th>Marital Status</th>

                        <th>Phone</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var member in Model)
                        {
                            <tr>

                                <td>

                                    <strong class="text-primary">

                                        @member.ChandaNo

                                    </strong>

                                </td>

                                <td>

                                    @member.FullName

                                </td>

                                <td>

                                    @member.Sex

                                </td>

                                <td>

                                    @member.JamaatName

                                </td>

                                <td>

                                    @if (member.MaritalStatus == "Married")
                                    {
                                        <span class="badge bg-success">

                                            Married

                                        </span>
                                    }
                                    else if (member.MaritalStatus == "Single")
                                    {
                                        <span class="badge bg-warning text-dark">

                                            Single

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            @member.MaritalStatus

                                        </span>
                                    }

                                </td>

                                <td>

                                    @member.PhoneNo

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7" class="text-center py-5">

                                <h5 class="text-muted">

                                    No registered members found.

                                </h5>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- Statistics -->

    <div class="row mt-5">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">

                        Total Members

                    </h6>

                    <h2 class="fw-bold text-primary">

                        @Model.Count()

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">

                        Married Members

                    </h6>

                    <h2 class="fw-bold text-success">

                        @Model.Count(x => x.MaritalStatus == "Married")

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">

                        Single Members

                    </h6>

                    <h2 class="fw-bold text-warning">

                        @Model.Count(x => x.MaritalStatus == "Single")

                    </h2>

                </div>

            </div>

        </div>

    </div>

</div>
