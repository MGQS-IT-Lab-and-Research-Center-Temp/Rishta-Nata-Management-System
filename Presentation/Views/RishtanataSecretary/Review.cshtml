@page
@model Presentation.ViewModels.RishtanataSecretaryDashboardViewModel.ReviewApplicationViewModel

@{
    Layout = "_RishtanataSecretaryLayout";
    ViewData["Title"] = "Review Nikah Application";
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-4">

        <a asp-controller="RishtanataSecretary"
           asp-action="PendingApprovals"
           class="btn btn-outline-secondary btn-sm mb-3">

            ← Back to Pending Approvals

        </a>

        <h2 class="fw-bold">

            Review Nikah Application

        </h2>

        <p class="text-muted">

            Carefully review the application and the Jama'at President's recommendation before making your decision.

        </p>

    </div>

    <!-- Status -->

    <div class="alert alert-warning">

        <strong>

            Pending Secretary Review

        </strong>

        <br />

        This application has been reviewed by the Jama'at President and is awaiting your decision.

    </div>

    <!-- Application Information -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <h4 class="mb-0">

                Application Information

            </h4>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label class="text-muted small">

                        Application Number

                    </label>

                    <div class="fw-bold">

                        @Model.ApplicationNumber

                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="text-muted small">

                        Status

                    </label>

                    <div>

                        <span class="badge bg-warning text-dark">

                            @Model.Status

                        </span>

                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="text-muted small">

                        Submitted Date

                    </label>

                    <div>

                        @Model.SubmittedDate.ToString("dd MMMM yyyy")

                    </div>

                </div>

                <div class="col-md-6 mb-3">

                    <label class="text-muted small">

                        Jama'at

                    </label>

                    <div>

                        @Model.JamaatName

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Couple Information -->

    <div class="row g-4 mb-4">

        <!-- Groom -->

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">

                    <h5 class="mb-0">

                        Groom Information

                    </h5>

                </div>

                <div class="card-body">

                    <p>

                        <strong>Name:</strong><br />

                        @Model.GroomName

                    </p>

                    <p>

                        <strong>Phone:</strong><br />

                        @Model.GroomPhone

                    </p>

                    <p>

                        <strong>Address:</strong><br />

                        @Model.GroomAddress

                    </p>

                </div>

            </div>

        </div>

        <!-- Bride -->

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header bg-white">

                    <h5 class="mb-0">

                        Bride Information

                    </h5>

                </div>

                <div class="card-body">

                    <p>

                        <strong>Name:</strong><br />

                        @Model.BrideName

                    </p>

                    <p>

                        <strong>Phone:</strong><br />

                        @Model.BridePhone

                    </p>

                    <p>

                        <strong>Address:</strong><br />

                        @Model.BrideAddress

                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- President Recommendation -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <h4 class="mb-0">

                Jama'at President Recommendation

            </h4>

        </div>

        <div class="card-body">

            <div class="mb-3">

                <label class="text-muted small">

                    President

                </label>

                <div class="fw-bold">

                    @Model.PresidentName

                </div>

            </div>

            <div class="mb-3">

                <label class="text-muted small">

                    Recommendation

                </label>

                <div>

                    @if (Model.IsApprovedByPresident)
                    {
                        <span class="badge bg-success">

                            Recommended for Approval

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">

                            Not Recommended

                        </span>
                    }

                </div>

            </div>

            <div>

            </div>

        </div>

    </div>

    <!-- Secretary Decision -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <h4 class="mb-1">

                Secretary Decision

            </h4>

            <small class="text-muted">

                Choose one of the following actions.

            </small>

        </div>

        <div class="card-body">

            <div class="d-flex flex-wrap gap-2">

                <form asp-action="Approve"
                      asp-controller="RishtanataSecretary"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button class="btn btn-success">

                        ✓ Approve Application

                    </button>

                </form>

                <form asp-action="Reject"
                      asp-controller="RishtanataSecretary"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button class="btn btn-danger">

                        ✕ Reject Application

                    </button>

                </form>

                <form asp-action="ReturnToPresident"
                      asp-controller="RishtanataSecretary"
                      method="post">

                    <input type="hidden"
                           name="id"
                           value="@Model.Id" />

                    <button class="btn btn-warning">

                        ↺ Return to President

                    </button>

                </form>

            </div>

        </div>

    </div>

    <!-- Workflow -->

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h4 class="mb-4">

                Review Workflow

            </h4>

            <div class="row text-center">

                <div class="col-md-3">

                    <div class="border rounded p-3">

                        <h5>1</h5>

                        <strong>Submitted</strong>

                        <div class="text-success mt-2">

                            ✓ Completed

                        </div>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="border rounded p-3">

                        <h5>2</h5>

                        <strong>President Review</strong>

                        <div class="text-success mt-2">

                            ✓ Completed

                        </div>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="border border-primary rounded p-3">

                        <h5 class="text-primary">

                            3

                        </h5>

                        <strong>

                            Secretary Review

                        </strong>

                        <div class="text-primary mt-2">

                            ● Current

                        </div>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="border rounded p-3">

                        <h5>4</h5>

                        <strong>

                            Final Approval

                        </strong>

                        <div class="text-muted mt-2">

                            Pending

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
