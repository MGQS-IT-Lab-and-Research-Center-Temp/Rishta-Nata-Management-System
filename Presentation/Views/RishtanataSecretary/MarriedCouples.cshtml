@page
@model IEnumerable<Presentation.ViewModels.RishtanataSecretaryDashboardViewModel.MarriedCoupleViewModel>

@{
    ViewData["Title"] = "Married Couples";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Registered Married Couples
            </h2>

            <p class="text-muted mb-0">
                View all marriages successfully registered in the system.
            </p>

        </div>

        <a asp-controller="RishtanataSecretary"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">

            ← Dashboard

        </a>

    </div>

    <!-- Search & Filter -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <input type="text"
                           class="form-control"
                           placeholder="Search Husband or Wife..." />

                </div>

                <div class="col-md-3">

                    <select class="form-select">

                        <option>All Jama'ats</option>
                        <option>Kano Central</option>
                        <option>Kaduna North</option>
                        <option>Abuja Central</option>
                        <option>Ibadan West</option>

                    </select>

                </div>

                <div class="col-md-3">

                    <input type="date"
                           class="form-control" />

                </div>

                <div class="col-md-2">

                    <button class="btn btn-primary w-100">

                        Search

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Married Couples Table -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h4 class="mb-1">
                        Marriage Register
                    </h4>

                    <small class="text-muted">
                        Official list of approved Nikah records.
                    </small>

                </div>

                <span class="badge bg-success fs-6">

                    @Model.Count() Registered

                </span>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Application No.</th>

                        <th>Groom Name</th>

                        <th>Bride Name</th>

                        <th>Nikah Date</th>

                        <th>Status</th>

                        <th>Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var couple in Model)
                        {
                            <tr>

                                <td>

                                    <strong class="text-primary">

                                        @couple.ApplicationNumber

                                    </strong>

                                </td>

                                <td>

                                    @couple.GroomName

                                </td>

                                <td>

                                    @couple.BrideName

                                </td>

                                <td>

                                    @couple.NikahDate.ToString("dd MMM yyyy")

                                </td>

                                <td>

                                    <span class="badge bg-success">

                                        @couple.Status

                                    </span>

                                </td>

                                <td>

                                    <button class="btn btn-outline-primary btn-sm">

                                        View

                                    </button>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7" class="text-center py-5">

                                <h5 class="text-muted">

                                    No marriage records found.

                                </h5>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- Summary Cards -->

    <div class="row mt-5">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">

                        Total Registered

                    </h6>

                    <h2 class="fw-bold text-success">

                        @Model.Count()

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">

                        Latest Registration

                    </h6>

                    <h5 class="fw-bold">

                        @Model.OrderByDescending(x => x.NikahDate)
                        .FirstOrDefault()?.MarriageDate
                        .ToString("dd MMM yyyy")

                    </h5>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">

                        Status

                    </h6>

                    <h5 class="text-success">

                        All Records Verified

                    </h5>

                </div>

            </div>

        </div>

    </div>

</div>
