@page
@model IEnumerable<Presentation.ViewModels.PendingApprovalViewModel>

@{
    ViewData["Title"] = "Pending Approvals";
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">

        <h1 class="fw-bold">
            Pending Nikah Applications
        </h1>

        <p class="text-muted">
            Review applications that have already been reviewed by the Jama'at President.
        </p>

    </div>

    <!-- Search and Filter -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-5">

                    <input type="text"
                           class="form-control"
                           placeholder="Search by Application Number, Groom or Bride..." />

                </div>

                <div class="col-md-3">

                    <select class="form-select">

                        <option>All Jama'ats</option>

                        <option>Kano Central</option>

                        <option>Kaduna North</option>

                        <option>Abuja Central</option>

                        <option>Ibadan West</option>

                    </select>

                </div>

                <div class="col-md-2">

                    <select class="form-select">

                        <option>All Status</option>

                        <option>Pending Secretary Review</option>

                        <option>Approved</option>

                        <option>Rejected</option>

                    </select>

                </div>

                <div class="col-md-2">

                    <button class="btn btn-primary w-100">

                        Search

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- Pending Applications -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h4 class="mb-1">

                        Applications Awaiting Secretary Review

                    </h4>

                    <small class="text-muted">

                        These applications have already been reviewed by the Jama'at President.

                    </small>

                </div>

                <span class="badge bg-warning text-dark fs-6">

                    @Model.Count() Pending

                </span>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Application No.</th>

                        <th>Groom</th>

                        <th>Bride</th>

                        <th>Jama'at</th>

                        <th>President</th>

                        <th>Submitted</th>

                        <th>Recommendation</th>

                        <th>Status</th>

                        <th width="150">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <strong class="text-primary">

                                        @item.ApplicationNumber

                                    </strong>

                                </td>

                                <td>

                                    @item.GroomName

                                </td>

                                <td>

                                    @item.BrideName

                                </td>

                                <td>

                                    @item.JamaatName

                                </td>

                                <td>

                                    @item.PresidentName

                                </td>

                                <td>

                                    @item.SubmittedDate.ToString("dd MMM yyyy")

                                </td>

                                <td>

                                    @if (item.PresidentRecommendation == "Recommended")
                                    {
                                        <span class="badge bg-success">

                                            Recommended

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">

                                            Not Recommended

                                        </span>
                                    }

                                </td>

                                <td>

                                    <span class="badge bg-warning text-dark">

                                        @item.Status

                                    </span>

                                </td>

                                <td>

                                    <a asp-controller="RishtanataSecretary"
                                       asp-action="Review"
                                       asp-route-id="@item.Id"
                                       class="btn btn-primary btn-sm">

                                        Review

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="9" class="text-center py-5">

                                <h5 class="text-muted">

                                    No pending applications.

                                </h5>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- Workflow Information -->

    <div class="card shadow-sm border-0 mt-5">

        <div class="card-body">

            <h4 class="mb-4">

                Approval Workflow

            </h4>

            <div class="row text-center">

                <div class="col-md-3">

                    <div class="border rounded p-3">

                        <h5>1</h5>

                        <strong>Application Submitted</strong>

                        <p class="small text-muted mt-2">

                            Applicant submits Nikah application.

                        </p>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="border rounded p-3">

                        <h5>2</h5>

                        <strong>Jama'at President Review</strong>

                        <p class="small text-muted mt-2">

                            President reviews and recommends.

                        </p>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="border border-primary rounded p-3">

                        <h5 class="text-primary">

                            3

                        </h5>

                        <strong>

                            Secretary Review

                        </strong>

                        <p class="small text-muted mt-2">

                            Current review stage.

                        </p>

                    </div>

                </div>

                <div class="col-md-3">

                    <div class="border rounded p-3">

                        <h5>4</h5>

                        <strong>

                            Final Approval

                        </strong>

                        <p class="small text-muted mt-2">

                            Marriage registration completed.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>