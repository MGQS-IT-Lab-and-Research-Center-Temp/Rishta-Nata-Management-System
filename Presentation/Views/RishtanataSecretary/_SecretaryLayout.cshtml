@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Rishtanata</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/secretary-dashboard.css" asp-append-version="true" />
</head>

<body>

    <div class="secretary-layout">

        <aside class="secretary-sidebar">

            <div class="sidebar-title">
                Rishtanata
            </div>

            <nav class="nav flex-column">

                <a class="nav-link"
                   asp-controller="RishtanataSecretary"
                   asp-action="Dashboard">
                    Dashboard
                </a>

                <a class="nav-link"
                   asp-controller="RishtanataSecretary"
                   asp-action="PendingApprovals">
                    Pending Approvals
                </a>

                <a class="nav-link"
                   asp-controller="RishtanataSecretary"
                   asp-action="MarriedCouples">
                    Married Couples
                </a>

                <a class="nav-link"
                   asp-controller="RishtanataSecretary"
                   asp-action="JamaatMembers">
                    Jama'at Members
                </a>

                <a class="nav-link"
                   asp-controller="Reports"
                   asp-action="Index">
                    Reports
                </a>

                <a class="nav-link logout-link"
                   asp-controller="Account"
                   asp-action="Logout">
                    Logout
                </a>

            </nav>

        </aside>

        <main class="secretary-content">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

</body>
</html>