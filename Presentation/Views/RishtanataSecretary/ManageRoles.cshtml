<!-- Current Roles -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">Current Roles</h5>
    </div>
    <div class="card-body">
        @foreach (var role in Model.CurrentRoles)
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <span class="badge @(role.HierarchyLevel == 1 ? "bg-primary" : "bg-dark") fs-6">
                        @role.Name
                    </span>
                    <small class="text-muted ms-2">Hierarchy level @role.HierarchyLevel</small>
                </div>
                @if (role.HierarchyLevel != 1)
                {
                    <form asp-action="RemoveRole" method="post" class="mb-0">
                        <input type="hidden" name="memberId" value="@Model.MemberId" />
                        <input type="hidden" name="roleId" value="@role.Id" />
                        <button type="submit"
                                class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Remove this role?');">
                            Remove
                        </button>
                    </form>
                }
            </div>
        }
        @if (Model.IsAtBaseRole)
        {
            <small class="text-muted">baseline &middot; cannot be reset further</small>
        }
    </div>
</div>