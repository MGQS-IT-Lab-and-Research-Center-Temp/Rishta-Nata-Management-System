@page
@model Presentation.ViewModels.RoleManagementViewModel

@{
    ViewData["Title"] = "Manage Roles";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Manage Roles</h2>
            <p class="text-muted mb-0">
                @Model.FullName <span class="text-muted">(@Model.MembershipNumber)</span>
            </p>
        </div>

        <a asp-controller="RishtanataSecretary"
           asp-action="JamaatMembers"
           class="btn btn-outline-secondary">
            ← Back to Members
        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <!-- Current Roles -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0">Current Roles</h5>
        </div>

        <div class="card-body">

            @if (!Model.AssignedRoles.Any())
            {
                <p class="text-muted mb-0">No roles assigned.</p>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2">

                    @foreach (var role in Model.AssignedRoles)
                    {
                        <div class="d-flex align-items-center border rounded px-3 py-2">

                            <span class="badge @(role.IsBaseline ? "bg-primary" : "bg-dark") me-2">
                                @role.RoleName
                            </span>

                            @if (role.IsBaseline)
                            {
                                <small class="text-muted">baseline · cannot be removed</small>
                            }
                            else
                            {
                                <form asp-action="RemoveRole" method="post" class="ms-2 mb-0">
                                    <input type="hidden" name="userId" value="@Model.UserId" />
                                    <input type="hidden" name="roleId" value="@role.RoleId" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Remove @role.RoleName from this member?');">
                                        Remove
                                    </button>
                                </form>
                            }

                        </div>
                    }

                </div>
            }

        </div>

    </div>

    <!-- Assign New Role -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">
            <h5 class="mb-0">Assign a Role</h5>
        </div>

        <div class="card-body">

            @if (!Model.AvailableRoles.Any())
            {
                <p class="text-muted mb-0">All roles have already been assigned to this member.</p>
            }
            else
            {
                <form asp-action="AssignRole" method="post" class="row g-3 align-items-end">

                    <input type="hidden" name="userId" value="@Model.UserId" />

                    <div class="col-md-6">
                        <label class="form-label">Role</label>
                        <select name="roleId" class="form-select" required>
                            <option value="" selected disabled>Select a role...</option>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role.RoleId">@role.RoleName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">Assign Role</button>
                    </div>

                </form>
            }
        </div>
    </div>
</div>