@page
@model Presentation.ViewModels.RishtanataSecretaryDashboardViewModel.RoleManagementViewModel

@{
    ViewData["Title"] = "Manage Role";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Manage Role</h2>
            <p class="text-muted mb-0">
                @Model.FullName <span class="text-muted">(@Model.ChandaNo)</span>
            </p>
        </div>

        <a asp-controller="RishtanataSecretary"
           asp-action="JamaatMembers"
           class="btn btn-outline-secondary">
            Back to Members
        </a>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <!-- Current Role -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0">Current Role</h5>
        </div>

        <div class="card-body d-flex justify-content-between align-items-center">

            <div>
                <span class="badge @(Model.IsAtBaseRole ? "bg-primary" : "bg-dark") fs-6">
                    @Model.CurrentRole.Name
                </span>
                <small class="text-muted ms-2">Hierarchy level @Model.CurrentRole.HierarchyLevel</small>
            </div>

            @if (Model.IsAtBaseRole)
            {
                <small class="text-muted">baseline · cannot be reset further</small>
            }
            else
            {
                <form asp-action="RemoveRole" method="post" class="mb-0">
                    <input type="hidden" name="memberId" value="@Model.MemberId" />
                    <button type="submit"
                            class="btn btn-sm btn-outline-danger"
                            onclick="return confirm('Reset this member to Jama\'at Member?');">
                        Reset to Jama'at Member
                    </button>
                </form>
            }

        </div>

    </div>

    <!-- Change Role -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">
            <h5 class="mb-0">Change Role</h5>
        </div>

        <div class="card-body">

            <form asp-action="ChangeRole" method="post" class="row g-3 align-items-end">

                <input type="hidden" name="memberId" value="@Model.MemberId" />

                <div class="col-md-6">
                    <label class="form-label">New Role</label>
                    <select name="roleId" class="form-select" required>
                        <option value="" selected disabled>Select a role...</option>
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <option value="@role.Id">@role.Name (Level @role.HierarchyLevel)</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">Update Role</button>
                </div>

            </form>

        </div>

    </div>

</div>
