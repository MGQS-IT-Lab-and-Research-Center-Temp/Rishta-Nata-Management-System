                <div class="card rn-service-card h-100">

                    <div class="rn-service-icon pink">
                        <i class="bi bi-heart-fill"></i>
                    </div>

                    <h4>
                        Marriage Application
                    </h4>

                    <p>
                        Submit and manage your Nikah application
