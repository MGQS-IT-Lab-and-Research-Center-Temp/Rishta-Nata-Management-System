                    </a>

                </div>

            </div>


            <!-- Certificate -->

            <div class="col-md-6 col-lg-4">

                <div class="card rn-service-card h-100">

                    <div class="rn-service-icon gold">
                        <i class="bi bi-file-earmark-check-fill"></i>
                    </div>

                    <h4>
                        Marriage Certificates
                    </h4>

                    <p>
                        Manage verified marriage records and
                        certificates through the Rishtanata system.
                    </p>

                    <a href="#dashboards"
