<!-- =========================================================
     HOW IT WORKS
========================================================= -->

<section id="how-it-works"
         class="rn-section rn-light-section">

    <div class="container">

        <div class="text-center mb-5">

            <span class="rn-section-label">
                HOW IT WORKS
            </span>

            <h2 class="rn-section-title">
                Simple.
                <span>Secure.</span>
                Straightforward.
            </h2>

        </div>


        <div class="row g-4">

            <div class="col-md-3">

                <div class="rn-step-card">

                    <div class="rn-step-number">
                        01
                    </div>

                    <i class="bi bi-person-plus-fill"></i>

                    <h5>
                        Register
                    </h5>

                    <p>
                        Create or access your Jama'at
                        member account.
                    </p>

                </div>

            </div>


            <div class="col-md-3">

                <div class="rn-step-card">

                    <div class="rn-step-number">
                        02
                    </div>

                    <i class="bi bi-pencil-square"></i>

                    <h5>
                        Apply
                    </h5>

                    <p>
                        Complete your marriage application
                        and submit the required details.
                    </p>

                </div>

            </div>


            <div class="col-md-3">

                <div class="rn-step-card">

                    <div class="rn-step-number">
                        03
                    </div>

                    <i class="bi bi-shield-check"></i>

                    <h5>
                        Verification
                    </h5>

                    <p>
                        Authorized Jama'at officials review
                        and verify your application.
                    </p>

                </div>

            </div>


            <div class="col-md-3">

                <div class="rn-step-card">

                    <div class="rn-step-number">
                        04
                    </div>

                    <i class="bi bi-file-earmark-check-fill"></i>

                    <h5>
                        Certificate
                    </h5>

                    <p>
                        Complete the process and manage
                        your verified certificate.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


