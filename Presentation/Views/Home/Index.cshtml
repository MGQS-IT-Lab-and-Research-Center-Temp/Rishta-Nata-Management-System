<!-- =========================================================
     ABOUT
========================================================= -->

<section id="about"
         class="rn-section bg-white">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <span class="rn-section-label">
                    ABOUT RISHTANATA
                </span>

                <h2 class="rn-section-title">

                    Bringing Marriage Services

                    <span>Together.</span>

                </h2>

            </div>


            <div class="col-lg-6">

                <p class="text-secondary fs-5">

                    Rishtanata provides a centralized platform
