                        View Dashboard
                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>


            <!-- Aqiqah -->

            <div class="col-md-6 col-lg-4">

                <div class="card rn-service-card h-100">

                    <div class="rn-service-icon green">
