@model Presentation.Views.Home.PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-page">
    <div class="container py-5">

        <div class="privacy-header text-center mb-5">
            <div class="privacy-icon">
                <i class="bi bi-shield-lock"></i>
            </div>

            <h1>Privacy Policy</h1>
            <p>
                Your privacy and security are important to us.
            </p>
        </div>

        <div class="privacy-card">

            <section>
                <h2>1. Introduction</h2>
                <p>
                    Rishtanata is committed to protecting the privacy and
                    security of information provided by users of our
                    marriage management system.
                </p>
            </section>

            <section>
                <h2>2. Information We Collect</h2>
                <p>
                    We may collect information required for marriage
                    applications, user accounts, certificates and
                    verification processes.
                </p>
            </section>

            <section>
                <h2>3. How We Use Your Information</h2>
                <p>
                    Information provided through Rishtanata is used to
                    process applications, verify submitted information,
                    manage certificates and provide system services.
                </p>
            </section>

            <section>
                <h2>4. Information Security</h2>
                <p>
                    We take reasonable measures to protect user information
                    against unauthorized access, modification or disclosure.
                </p>
            </section>

            <section>
                <h2>5. Data Sharing</h2>
                <p>
                    User information is only shared with authorized personnel
                    when required for legitimate system and administrative
                    purposes.
                </p>
            </section>

            <section>
                <h2>6. Contact Us</h2>
                <p>
                    If you have questions about this Privacy Policy,
                    please contact the Rishtanata administration.
                </p>
            </section>

        </div>

        <div class="text-center mt-4">
            <a asp-controller="Home"asp-action="Index"class="btn btn-success">
                <i class="bi bi-arrow-left"></i>
                Back to Home
            </a>
        </div>

    </div>
</div>



