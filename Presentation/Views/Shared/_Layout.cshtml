@using System.Security.Claims
@{
    var displayName = User?.FindFirst("FullName")?.Value;

    displayName = string.IsNullOrWhiteSpace(displayName)
        ? "Member"
        : displayName.Trim();

    var firstName = displayName
        .Split(separator: ' ', StringSplitOptions.RemoveEmptyEntries)
        .FirstOrDefault() ?? "Member";

    var profileRole = User?.FindFirst(ClaimTypes.Role)?.Value;

    if (string.IsNullOrWhiteSpace(profileRole))
    {
        profileRole = "Member";
    }

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsActive(string controller, string? action = null) =>
        string.Equals(controller, currentController, StringComparison.OrdinalIgnoreCase) &&
        (action is null ||
         string.Equals(action, currentAction, StringComparison.OrdinalIgnoreCase));
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rishtanata</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Outfit:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>

<body>
    <div class="app-shell">

        <!-- TOP HEADER -->
        <header class="topbar">
            <button class="nav-toggle" id="navToggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sidebar">
                <i class="bi bi-list"></i>
            </button>

            <a class="brand-area" asp-controller="Home" asp-action="Index">
                <div class="brand-icon">
                    <img src="~/img/logo.png" alt="Rishtanata logo" />
                </div>

                <div>
                    <div class="brand-name">Rishtanata</div>
                    <div class="brand-subtitle">Management System</div>
                </div>
            </a>

            <div class="topbar-spacer"></div>

            <div class="topbar-user">
                <div class="greeting">
                    <span>As-salaamu alaykum,</span>
                    <strong>@firstName</strong>
                </div>

                <div class="header-avatar" title="@displayName">
                    <i class="bi bi-person-fill"></i>
                </div>
            </div>
        </header>

        <div class="app-body">

            <!-- SIDEBAR -->
            <aside class="sidebar" id="sidebar">
                <div class="profile-block">
                    <div class="sidebar-avatar" title="@displayName">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div>
                        <div class="profile-name">@displayName</div>
                        <div class="profile-role">@profileRole</div>
                    </div>
                </div>

                <nav class="sidebar-nav" aria-label="Main navigation">
                    <a class="nav-item @(IsActive("JamaatMemberDashboard") ? "active" : "")"
                       asp-controller="JamaatMemberDashboard"
                       asp-action="Index">
                        <i class="bi bi-grid-fill"></i>
                        <span>Dashboard</span>
                    </a>

                    <a class="nav-item @(IsActive("Applications") ? "active" : "")"
                       asp-controller="Applications"
                       asp-action="Index">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>My Applications</span>
                    </a>

                    <a class="nav-item @(IsActive("MarriageApplication", "Create") ? "active" : "")"
                       asp-controller="MarriageApplication"
                       asp-action="Create">
                        <i class="bi bi-file-earmark-plus"></i>
                        <span>Apply for Nikah</span>
                    </a>

                    <a class="nav-item @(IsActive("Profile") ? "active" : "")"
                       asp-controller="Profile"
                       asp-action="Index">
                        <i class="bi bi-person-circle"></i>
                        <span>My Profile</span>
                    </a>
                </nav>

                <div class="sidebar-bottom">
                    <form class="logout-form"
                          asp-controller="Auth"
                          asp-action="Logout"
                          method="post">
                        <button type="submit" class="nav-item">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </div>
            </aside>

            <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

            <!-- MAIN CONTENT -->
            <main class="main-content">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @success
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @error
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["Info"] is string info)
                {
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        @info
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>

        <!-- FOOTER -->
        <footer class="app-footer">
            <span>
                &copy; @DateTime.Now.Year Rishtanata Management System. All rights reserved.
                &middot;
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </span>

        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
