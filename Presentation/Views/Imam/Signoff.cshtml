@model Presentation.ViewModels.Imam.ImamSignoffViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign Off";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm mb-3">Back to my sign-offs</a>
        <h2 class="fw-bold">Sign off — @Model.ReferenceNumber</h2>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <small class="text-muted">Bride</small>
                    <div class="fw-bold">@Model.BrideName</div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">Bridegroom</small>
                    <div class="fw-bold">@Model.BridegroomName</div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">Approved Nikah date</small>
                    <div class="fw-bold">
                        @(Model.ApprovedDateOfNikah?.ToString("dd MMMM yyyy") ?? "—")
                    </div>
                </div>
                <div class="col-md-6">
                    <small class="text-muted">Venue</small>
                    <div class="fw-bold">
                        @(string.IsNullOrWhiteSpace(Model.Venue) ? "—" : Model.Venue)
                    </div>
                </div>
            </div>

            <div class="alert alert-info mt-4 mb-0">
                Confirm below that you officiated the ceremony on the approved date at the venue above.
            </div>
        </div>
    </div>

    <form asp-action="Signoff" asp-route-id="@Model.FormId" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5 class="mb-4">Officiating Imam — your details</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="AddressJamaat" class="form-label">Jama'at / Address</label>
                        <input asp-for="AddressJamaat" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Tel" class="form-label">Telephone</label>
                        <input asp-for="Tel" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SignatureDate" class="form-label">Signature date</label>
                        <input asp-for="SignatureDate" class="form-control" placeholder="yyyy-MM-dd" />
                        <span asp-validation-for="SignatureDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Sign off</button>
        </div>
    </form>
</div>