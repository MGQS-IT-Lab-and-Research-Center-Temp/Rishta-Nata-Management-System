@model Presentation.ViewModels.BridegroomFormViewModel
@{
    Layout = null;
    ViewData["Title"] = "Groom Information | Rishta-Nata";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --rn-navy: #1e2957;
            --rn-blue: #335ab7;
            --rn-pink: #de3f77;
            --rn-green: #489b43;
            --rn-purple: #7d4cb9;
            --rn-orange: #f59a23;
            --rn-background: #fcfefd;
            --rn-border: #e1e6ec;
            --rn-muted: #64708c;
        }
        body { background:var(--rn-background); color:var(--rn-navy); font-family:Arial, Helvetica, sans-serif; }
        .page-shell { max-width:980px; margin:0 auto; padding:28px 20px 48px; }
        .application-header { background:#fff; border:1px solid var(--rn-border); border-radius:10px; padding:18px 22px; }
        .brand,.application-title { color:var(--rn-navy); font-weight:800; margin:0; }
        .brand { font-size:1.25rem; } .application-title { font-size:1.15rem; }
        .mosque-mark { border-radius:50%; display:block; height:48px; object-fit:cover; width:48px; }
        .brand-subtitle,.page-subtitle,.text-muted { color:var(--rn-muted)!important; font-size:.84rem; }
        .reference-box { background:#fff; border:1px solid var(--rn-border); border-radius:8px; min-width:170px; padding:9px 13px; }
        .reference-box strong { color:var(--rn-navy); font-size:1.05rem; }
        .status-badge { background:var(--rn-blue); color:#fff; font-size:.72rem; padding:6px 18px; border-radius:4px; }
        .progress-card,.groom-card,.help-card { background:#fff; border:1px solid var(--rn-border); border-radius:8px; }
        .progress-card { padding:16px 20px; } .progress { height:6px; background:#e7edf7; } .progress-bar { background:var(--rn-blue); }
        .groom-card { overflow:hidden; } .groom-card-header { padding:16px 20px 12px; border-bottom:1px solid #e5edf7; }
        .groom-card-header h1 { color:var(--rn-navy); font-size:1rem; font-weight:800; margin:0; }
        .groom-icon { align-items:center; background:#e7f0fb; border-radius:50%; color:var(--rn-blue); display:flex; font-size:1rem; height:30px; justify-content:center; width:30px; }
        .header-line { background:var(--rn-blue); border-radius:99px; height:3px; margin-top:12px; width:58px; }
        .groom-card-body { padding:20px; }.form-label { color:#24395f; font-size:.8rem; font-weight:700; }.required { color:#d83556; }
        .form-control,.form-select { border-color:#d8e0ec; font-size:.88rem; min-height:42px; }.form-control:focus,.form-select:focus { border-color:var(--rn-blue); box-shadow:0 0 0 .18rem rgba(30,94,174,.14); }
        .details-card { background:#f9fbfe; border:1px solid #e0e8f2; border-radius:7px; padding:16px; }.details-card summary { color:var(--rn-navy); cursor:pointer; font-size:.9rem; font-weight:700; }
        .btn-rn-primary { background:var(--rn-blue); border-color:var(--rn-blue); color:#fff; font-weight:700; min-width:178px; padding:10px 24px; }.btn-rn-primary:hover { background:#284a9a; border-color:#284a9a; color:#fff; }
        .help-card { color:var(--rn-muted); font-size:.82rem; padding:14px 17px; }
        @@media (max-width:575.98px) { .page-shell { padding:16px 12px 30px; }.application-header { padding:15px; }.reference-box { width:100%; }.btn-rn-primary { width:100%; } }
    </style>
</head>
<body>
    <main class="page-shell">
        <header class="application-header mb-4">
            <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <img class="mosque-mark" src="~/img/ahmadiyya-mosque-mark.png" alt="Ahmadiyya mosque emblem" />
                    <div><p class="brand">Rishta-Nata</p><p class="brand-subtitle mb-0">Marriage Application System</p></div>
                </div>
                <div class="flex-grow-1 ms-md-4"><h2 class="application-title">Marriage Application Form </h2><p class="page-subtitle mb-0">Each participant completes their section using a secure invitation link.</p></div>
                <div class="d-flex gap-3 align-items-center"><span class="status-badge">In Progress</span></div>
            </div>
        </header>
        <section class="progress-card mb-4" aria-label="Application progress">
            <div class="d-flex justify-content-between small mb-2"><span class="fw-bold">Groom information</span><span class="text-muted">Step 1 of 6</span></div>
            <div class="progress"><div class="progress-bar" role="progressbar" style="width:17%" aria-valuenow="17" aria-valuemin="0" aria-valuemax="100"></div></div>
            <div class="d-flex justify-content-between mt-2 small text-muted"><span>Groom</span><span>Bride</span><span>Guardian</span><span>Witnesses</span><span>Review</span></div>
        </section>
        <form asp-action="Create" asp-controller="Bridegroom" method="post">
            @Html.AntiForgeryToken()
            <section class="groom-card mb-3">
                <div class="groom-card-header"><div class="d-flex align-items-center justify-content-between"><div class="d-flex align-items-center gap-2"><span class="groom-icon" aria-hidden="true">♙</span><h1>B. Groom Information</h1></div><span class="small text-muted">Step 1 of 6</span></div><div class="header-line"></div></div>
                <div class="groom-card-body"><div class="row g-3">
                    <div class="col-12"><label asp-for="BridegroomName" class="form-label"></label> <span class="required">*</span><input asp-for="BridegroomName" class="form-control" placeholder="Enter full name" autocomplete="name" /><span asp-validation-for="BridegroomName" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="BridegroomMembershipNo" class="form-label"></label> <span class="required">*</span><input asp-for="BridegroomMembershipNo" class="form-control" placeholder="Enter membership number" /><span asp-validation-for="BridegroomMembershipNo" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="BridegroomDateOfBirth" class="form-label"></label> <span class="required">*</span><input asp-for="BridegroomDateOfBirth" class="form-control" type="date" /><span asp-validation-for="BridegroomDateOfBirth" class="text-danger small"></span></div>
                    <div class="col-12"><label asp-for="BridegroomResidentOf" class="form-label"></label> <span class="required">*</span><input asp-for="BridegroomResidentOf" class="form-control" placeholder="Enter full residential address" autocomplete="street-address" /><span asp-validation-for="BridegroomResidentOf" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="BridegroomPhoneNumber" class="form-label"></label> <span class="required">*</span><input asp-for="BridegroomPhoneNumber" class="form-control" placeholder="03xx-xxxxxxx" autocomplete="tel" /><span asp-validation-for="BridegroomPhoneNumber" class="text-danger small"></span></div>
                    <div class="col-md-3"><label asp-for="BridegroomGenotype" class="form-label">Genotype</label><select asp-for="BridegroomGenotype" class="form-select"><option value="">Select</option><option>AA</option><option>AS</option><option>SS</option><option>AC</option><option>SC</option><option>Other</option></select></div>
                    <div class="col-md-3"><label asp-for="BridegroomBloodGroup" class="form-label">Blood Group</label><select asp-for="BridegroomBloodGroup" class="form-select"><option value="">Select</option><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>O+</option><option>O-</option></select></div>
                </div></div>
            </section>
            <details class="details-card mb-3"><summary>Additional Nikah and dower details</summary><div class="row g-3 mt-1">
                <div class="col-md-6"><label asp-for="BridegroomDowerAmountPaidInCash" class="form-label">Dower paid in cash</label><input asp-for="BridegroomDowerAmountPaidInCash" class="form-control" type="number" min="0" step="0.01" placeholder="0.00" /></div>
                <div class="col-md-6"><label asp-for="BridegroomDowerAmountToBePaid" class="form-label">Dower amount yet to be paid</label><input asp-for="BridegroomDowerAmountToBePaid" class="form-control" type="number" min="0" step="0.01" placeholder="0.00" /></div>
                <div class="col-md-6"><label class="form-label d-block">Is this your first Nikah?</label><div class="form-check form-check-inline"><input asp-for="IsFirstNikah" class="form-check-input" type="radio" value="true" id="firstNikahYes" /><label class="form-check-label" for="firstNikahYes">Yes</label></div><div class="form-check form-check-inline"><input asp-for="IsFirstNikah" class="form-check-input" type="radio" value="false" id="firstNikahNo" /><label class="form-check-label" for="firstNikahNo">No</label></div></div>
                <div class="col-md-6"><label class="form-label d-block">Is this a second, third or fourth Nikah?</label><div class="form-check form-check-inline"><input asp-for="IsSecondThirdOrFourthNikah" class="form-check-input" type="radio" value="true" id="multipleNikahYes" /><label class="form-check-label" for="multipleNikahYes">Yes</label></div><div class="form-check form-check-inline"><input asp-for="IsSecondThirdOrFourthNikah" class="form-check-input" type="radio" value="false" id="multipleNikahNo" /><label class="form-check-label" for="multipleNikahNo">No</label></div></div>
                <div class="col-12"><div class="row"><div class="col-md-6 form-check ms-2"><input asp-for="FormerWifeIsDead" class="form-check-input" /><label asp-for="FormerWifeIsDead" class="form-check-label">Former wife is deceased</label></div><div class="col-md-5 form-check ms-2"><input asp-for="HasDivorcedFormerWife" class="form-check-input" /><label asp-for="HasDivorcedFormerWife" class="form-check-label">Former wife was divorced</label></div><div class="col-md-6 form-check ms-2 mt-2"><input asp-for="FormerWifeIsPresent" class="form-check-input" /><label asp-for="FormerWifeIsPresent" class="form-check-label">Former wife is present</label></div><div class="col-md-5 form-check ms-2 mt-2"><input asp-for="FormerWifeObtainedKhula" class="form-check-input" /><label asp-for="FormerWifeObtainedKhula" class="form-check-label">Former wife obtained Khula</label></div></div></div>
            </div></details>
            <div class="help-card mb-3">After saving, the bride and other participants will receive their own secure form links. They can only complete their assigned section.</div>
            <div class="d-flex justify-content-end"><button type="submit" class="btn btn-rn-primary">Save &amp; Continue <span aria-hidden="true">→</span></button></div>
        </form>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
