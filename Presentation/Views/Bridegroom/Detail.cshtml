
@model Presentation.ViewModel.MarriageApplicationFormViewModel

@{
    ViewData["Title"] = "Marriage Application Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Marriage Application Details</h2>
            <p class="text-muted mb-0">
                Review the information submitted for this marriage application.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-outline-secondary">
            ← Back
        </a>
    </div>

    <!-- Application Information -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Application Information</h5>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Reference Number</label>
                    <div class="fw-semibold">
                        @Model.ReferenceNumber
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Proposed Nikah Date</label>
                    <div class="fw-semibold">
                        @Model.ProposedNikahDate.ToString("dd MMMM yyyy")
                    </div>
                </div>

                <div class="col-12">
                    <label class="text-muted small">Venue</label>
                    <div class="fw-semibold">
                        @Model.Venue
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bride Information -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Bride Information</h5>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Membership Number</label>
                    <div>@Model.BrideMembershipNo</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Full Name</label>
                    <div class="fw-semibold">@Model.BrideName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Date of Birth</label>
                    <div>@Model.BrideDateOfBirth.ToString("dd MMMM yyyy")</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Resident Of</label>
                    <div>@Model.BrideResidentOf</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Genotype</label>
                    <div>@Model.BrideGenotype</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Blood Group</label>
                    <div>@Model.BrideBloodGroup</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Marital Status</label>
                    <div>@Model.BrideMaritalStatus</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Proposed Dower</label>
                    <div class="fw-semibold">
                        @Model.BrideProposedDowerAmount.ToString("N2")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Dower Received in Cash</label>
                    <div class="fw-semibold">
                        @Model.BrideDowerAmountReceivedInCash.ToString("N2")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">Father's Name</label>
                    <div>@Model.BrideFatherName</div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">Signature / Telephone</label>
                    <div>@Model.BrideSignatureTel</div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bridegroom Information -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Bridegroom Information</h5>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Membership Number</label>
                    <div>@Model.BridegroomMembershipNo</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Full Name</label>
                    <div class="fw-semibold">@Model.BridegroomName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Date of Birth</label>
                    <div>
                        @Model.BridegroomDateOfBirth.ToString("dd MMMM yyyy")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Resident Of</label>
                    <div>@Model.BridegroomResidentOf</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Genotype</label>
                    <div>@Model.BridegroomGenotype</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Blood Group</label>
                    <div>@Model.BridegroomBloodGroup</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="text-muted small">Father's Name</label>
                    <div>@Model.BridegroomFatherName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Dower Paid in Cash</label>
                    <div class="fw-semibold">
                        @Model.BridegroomDowerAmountPaidInCash.ToString("N2")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Dower Amount to be Paid</label>
                    <div class="fw-semibold">
                        @Model.BridegroomDowerAmountToBePaid.ToString("N2")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">Signature / Telephone</label>
                    <div>@Model.BridegroomSignatureTel</div>
                </div>

            </div>
        </div>
    </div>

    <!-- Nikah Information -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Nikah Information</h5>
        </div>

        <div class="card-body">

            <div class="mb-4">
                <label class="text-muted small d-block mb-2">
                    Nikah Status
                </label>

                @if (Model.IsFirstNikah)
                {
                    <span class="badge bg-success">First Nikah</span>
                }
                else if (Model.IsSecondThirdOrFourthNikah)
                {
                    <span class="badge bg-warning text-dark">
                        Second / Third / Fourth Nikah
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">Not Specified</span>
                }
            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Former Wife Deceased</label>
                    <div>
                        @(Model.FormerWifeIsDead ? "Yes" : "No")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Former Wife Divorced</label>
                    <div>
                        @(Model.HasDivorcedFormerWife ? "Yes" : "No")
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Former Wife Present</label>
                    <div>
                        @(Model.FormerWifeIsPresent ? "Yes" : "No")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">Former Wife Obtained Khula</label>
                    <div>
                        @(Model.FormerWifeObtainedKhula ? "Yes" : "No")
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Guardian -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Guardian / Waliyy</h5>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Name</label>
                    <div>@Model.GuardianName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Relationship to Bride</label>
                    <div>@Model.GuardianRelationToBride</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Telephone</label>
                    <div>@Model.GuardianTel</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Signature Date</label>
                    <div>@Model.GuardianSignatureDate</div>
                </div>

                <div class="col-12">
                    <label class="text-muted small">Address</label>
                    <div>@Model.GuardianAddress</div>
                </div>

            </div>
        </div>
    </div>

    <!-- Representative -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Representative / Wakeel</h5>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Name</label>
                    <div>@Model.RepresentativeName</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="text-muted small">Acting For</label>
                    <div>@Model.RepresentativeActingFor</div>
                </div>

                <div class="col-12 mb-3">
                    <label class="text-muted small">Address</label>
                    <div>@Model.RepresentativeAddress</div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">Signature Date</label>
                    <div>@Model.RepresentativeSignatureDate</div>
                </div>

            </div>
        </div>
    </div>

    <!-- Witnesses -->
    <div class="row">

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Witness One</h5>
                </div>

                <div class="card-body">
                    <p>
                        <span class="text-muted small">Name</span><br />
                        @Model.WitnessOneName
                    </p>

                    <p>
                        <span class="text-muted small">Telephone</span><br />
                        @Model.WitnessOneTel
                    </p>

                    <p>
                        <span class="text-muted small">Address</span><br />
                        @Model.WitnessOneAddress
                    </p>

                    <p class="mb-0">
                        <span class="text-muted small">Signature Date</span><br />
                        @Model.WitnessOneSignatureDate
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Witness Two</h5>
                </div>

                <div class="card-body">
                    <p>
                        <span class="text-muted small">Name</span><br />
                        @Model.WitnessTwoName
                    </p>

                    <p>
                        <span class="text-muted small">Telephone</span><br />
                        @Model.WitnessTwoTel
                    </p>

                    <p>
                        <span class="text-muted small">Address</span><br />
                        @Model.WitnessTwoAddress
                    </p>

                    <p class="mb-0">
                        <span class="text-muted small">Signature Date</span><br />
                        @Model.WitnessTwoSignatureDate
                    </p>
                </div>
            </div>
        </div>

    </div>

</div>
```
