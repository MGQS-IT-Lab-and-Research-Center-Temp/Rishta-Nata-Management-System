    <div class="d-flex justify-content-end mb-5">
        <button type="submit" class="btn btn-primary">Save &amp; Continue</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            'use strict';

            var groomRadio = document.getElementById('partyGroom');
            var brideRadio = document.getElementById('partyBride');
            var groomBadge = document.getElementById('groomBadge');
            var brideBadge = document.getElementById('brideBadge');
            var groomCard = document.getElementById('groomCard');
            var brideCard = document.getElementById('brideCard');

            function updateBadges() {
                var isGroom = groomRadio && groomRadio.checked;
                if (groomBadge) { groomBadge.textContent = isGroom ? '(You)' : '(Partner)'; }
                if (brideBadge) { brideBadge.textContent = isGroom ? '(Partner)' : '(You)'; }
            }

            function reorderCards() {
                if (!groomCard || !brideCard || groomCard.parentNode !== brideCard.parentNode) { return; }
                var isGroom = groomRadio && groomRadio.checked;
                var container = groomCard.parentNode;
                if (isGroom) {
                    container.insertBefore(groomCard, brideCard);
                } else {
                    container.insertBefore(brideCard, groomCard);
                }
            }

            function updateLayout() {
                updateBadges();
                reorderCards();
            }

            if (groomRadio) { groomRadio.addEventListener('change', updateLayout); }
            if (brideRadio) { brideRadio.addEventListener('change', updateLayout); }
            updateLayout();

            function fillDate(input, value) {
                var d = new Date(value);
                if (isNaN(d.getTime())) { return; }
                var mm = String(d.getMonth() + 1).padStart(2, '0');
                var dd = String(d.getDate()).padStart(2, '0');
                input.value = d.getFullYear() + '-' + mm + '-' + dd;
            }

            function wireLookup(membershipId, nameId, dobId, addressId, phoneId) {
                var input = document.getElementById(membershipId);
                if (!input) { return; }
                input.addEventListener('change', function () {
                    var chandaNo = input.value.trim();
                    if (!chandaNo) { return; }
                    fetch('/api/members/lookup/' + encodeURIComponent(chandaNo))
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (m) {
                            if (!m) { return; }
                            if (nameId) { var n = document.getElementById(nameId); if (n) { n.value = m.fullName || ''; } }
                            if (dobId) { var d = document.getElementById(dobId); if (d && m.dateOfBirth) { fillDate(d, m.dateOfBirth); } }
                            if (addressId) { var a = document.getElementById(addressId); if (a) { a.value = m.address || ''; } }
                            if (phoneId) { var p = document.getElementById(phoneId); if (p) { p.value = m.phoneNo || ''; } }
                        })
                        .catch(function (err) { console.warn('Member lookup failed', err); });
                });
            }

            wireLookup('Bridegroom_MembershipNo', 'Bridegroom_Name', 'Bridegroom_DateOfBirth', 'Bridegroom_ResidentOf', 'Bridegroom_Phone');
            wireLookup('Bride_MembershipNo', 'Bride_Name', 'Bride_DateOfBirth', 'Bride_ResidentOf', 'Bride_Phone');
        })();
    </script>
}
