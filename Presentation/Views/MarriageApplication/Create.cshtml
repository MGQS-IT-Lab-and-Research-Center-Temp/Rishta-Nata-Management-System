                        <input asp-for="Bridegroom.ResidentOf" class="form-control" />
                        <span asp-validation-for="Bridegroom.ResidentOf" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Bridegroom.Genotype" class="form-label"></label>
                        <select asp-for="Bridegroom.Genotype" class="form-select">
                            <option value="">Select</option>
                            <option>AA</option><option>AS</option><option>SS</option>
                            <option>AC</option><option>SC</option><option>Other</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Bridegroom.BloodGroup" class="form-label"></label>
                        <select asp-for="Bridegroom.BloodGroup" class="form-select">
                            <option value="">Select</option>
                            <option>A+</option><option>A-</option><option>B+</option><option>B-</option>
