                            <input asp-for="IsFirstNikah" class="form-check-input" type="radio" value="false" id="firstNikahNo" />
                            <label class="form-check-label" for="firstNikahNo">No</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label d-block">Is this a second, third or fourth Nikah?</label>
                        <div class="form-check form-check-inline">
                            <input asp-for="IsSecondThirdOrFourthNikah" class="form-check-input" type="radio" value="true" id="multiNikahYes" />
                            <label class="form-check-label" for="multiNikahYes">Yes</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input asp-for="IsSecondThirdOrFourthNikah" class="form-check-input" type="radio" value="false" id="multiNikahNo" />
                            <label class="form-check-label" for="multiNikahNo">No</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card dashboard-card mb-4" id="groomCard">
            <div class="card-header">
                Bridegroom Information
                <span class="badge rounded-pill text-bg-light ms-2" id="groomBadge">(You)</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Bridegroom.MembershipNo" class="form-label"></label>
                        <input asp-for="Bridegroom.MembershipNo" class="form-control" />
                        <span asp-validation-for="Bridegroom.MembershipNo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Bridegroom.Name" class="form-label"></label>
