@model Presentation.ViewModels.NewApplicationViewModel

@{
    ViewData["Title"] = "New Application";
}

<div class="dashboard-hero">
    <h1>New Marriage Application</h1>
    <p>Start your Nikah application. You can apply as the groom or the bride — your details are pre-filled from your membership record.</p>
</div>

<form asp-controller="MarriageApplication" asp-action="Create" method="post" id="appForm" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card dashboard-card mb-4">
        <div class="card-header">Who is starting this application?</div>
        <div class="card-body">
            <div class="btn-group" role="group" aria-label="Starting party">
                <input type="radio" asp-for="StartingParty" value="Groom" id="partyGroom" class="btn-check" autocomplete="off" />
                <label class="btn btn-outline-primary" for="partyGroom">I am the Groom</label>

                <input type="radio" asp-for="StartingParty" value="Bride" id="partyBride" class="btn-check" autocomplete="off" />
                <label class="btn btn-outline-primary" for="partyBride">I am the Bride</label>
            </div>
        </div>
    </div>

    @if (Model.StartingParty == "Bride")
    {
        <div class="card dashboard-card mb-4" id="brideCard">
            <div class="card-header">
                Bride Information
                <span class="badge rounded-pill text-bg-light ms-2" id="brideBadge">(You)</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Bride.MembershipNo" class="form-label"></label>
                        <input asp-for="Bride.MembershipNo" class="form-control" />
                        <span asp-validation-for="Bride.MembershipNo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Bride.Name" class="form-label"></label>
                        <input asp-for="Bride.Name" class="form-control" />
                        <span asp-validation-for="Bride.Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Bride.DateOfBirth" class="form-label"></label>
                        <input asp-for="Bride.DateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="Bride.DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Bride.Phone" class="form-label"></label>
                        <input asp-for="Bride.Phone" class="form-control" />
                        <span asp-validation-for="Bride.Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Bride.ResidentOf" class="form-label"></label>
                        <input asp-for="Bride.ResidentOf" class="form-control" />
                        <span asp-validation-for="Bride.ResidentOf" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Bride.Genotype" class="form-label"></label>
                        <select asp-for="Bride.Genotype" class="form-select">
                            <option value="">Select</option>
                            <option>AA</option><option>AS</option><option>SS</option>
                            <option>AC</option><option>SC</option><option>Other</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Bride.BloodGroup" class="form-label"></label>
                        <select asp-for="Bride.BloodGroup" class="form-select">
                            <option value="">Select</option>
                            <option>A+</option><option>A-</option><option>B+</option><option>B-</option>
                            <option>AB+</option><option>AB-</option><option>O+</option><option>O-</option>
                        </select>
                    </div>

                    <div class="col-12"><hr class="my-1" /></div>

                    <div class="col-md-4">
                        <label asp-for="BrideMaritalStatus" class="form-label"></label>
                        <select asp-for="BrideMaritalStatus" class="form-select" required>
                            <option value="">Select</option>
                            <option value="Unmarried">@Domain.Enums.BrideMaritalStatusText.ToLabel(Domain.Enums.BrideMaritalStatus.Unmarried)</option>
                            <option value="WidowedIddatComplete">@Domain.Enums.BrideMaritalStatusText.ToLabel(Domain.Enums.BrideMaritalStatus.WidowedIddatComplete)</option>
                            <option value="DivorcedIddatComplete">@Domain.Enums.BrideMaritalStatusText.ToLabel(Domain.Enums.BrideMaritalStatus.DivorcedIddatComplete)</option>
                        </select>
                        <span asp-validation-for="BrideMaritalStatus" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 d-none" id="khulaEvidenceGroup">
                        <label asp-for="BrideDivorceEvidence" class="form-label">
                            Evidence of Khula (divorce certificate reference / number)
                        </label>
                        <input asp-for="BrideDivorceEvidence" class="form-control" />
                        <label asp-for="BrideDivorceEvidenceFile" class="form-label mt-2"></label>
                        <input asp-for="BrideDivorceEvidenceFile" type="file" class="form-control"
                               accept="@Application.DivorceEvidence.DivorceEvidenceRules.AcceptAttribute" />
                        <span asp-validation-for="BrideDivorceEvidenceFile" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BrideProposedDowerAmount" class="form-label"></label>
                        <input asp-for="BrideProposedDowerAmount" class="form-control" type="number" min="0" step="0.01" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BrideDowerAmountReceivedInCash" class="form-label"></label>
                        <input asp-for="BrideDowerAmountReceivedInCash" class="form-control" type="number" min="0" step="0.01" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card dashboard-card mb-4" id="groomCard">
            <div class="card-header">
                Bridegroom Details
                <span class="badge rounded-pill text-bg-light ms-2" id="groomBadge">(Partner)</span>
            </div>
            <div class="card-body">
                <p class="text-muted small">Enter your partner's membership number. Their details will be loaded automatically.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Bridegroom.MembershipNo" class="form-label"></label>
                        <input asp-for="Bridegroom.MembershipNo" class="form-control" id="partnerMembershipNo" />
                        <span asp-validation-for="Bridegroom.MembershipNo" class="text-danger small"></span>
                    </div>
                </div>
                <div id="partnerPreview" class="mt-3 d-none">
                    <div class="alert alert-light border mb-0">
                        <strong>Name:</strong> <span id="pvName"></span><br/>
                        <strong>Date of Birth:</strong> <span id="pvDob"></span><br/>
                        <strong>Address:</strong> <span id="pvAddress"></span><br/>
                        <strong>Phone:</strong> <span id="pvPhone"></span>
                    </div>
                </div>
                <div id="partnerNotFound" class="alert alert-warning d-none mt-3">We couldn't find that membership number. Please check it and try again.</div>
                <div id="partnerBlocked" class="alert alert-danger d-none mt-3"></div>
            </div>
        </div>
    }
    else
    {
        <div class="card dashboard-card mb-4" id="groomCard">
            <div class="card-header">
                Bridegroom Information
                <span class="badge rounded-pill text-bg-light ms-2" id="groomBadge">(You)</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Bridegroom.MembershipNo" class="form-label"></label>
                        <input asp-for="Bridegroom.MembershipNo" class="form-control" />
                        <span asp-validation-for="Bridegroom.MembershipNo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Bridegroom.Name" class="form-label"></label>
                        <input asp-for="Bridegroom.Name" class="form-control" />
                        <span asp-validation-for="Bridegroom.Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Bridegroom.DateOfBirth" class="form-label"></label>
                        <input asp-for="Bridegroom.DateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="Bridegroom.DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Bridegroom.Phone" class="form-label"></label>
                        <input asp-for="Bridegroom.Phone" class="form-control" />
                        <span asp-validation-for="Bridegroom.Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Bridegroom.ResidentOf" class="form-label"></label>
                        <input asp-for="Bridegroom.ResidentOf" class="form-control" />
                        <span asp-validation-for="Bridegroom.ResidentOf" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Bridegroom.Genotype" class="form-label"></label>
                        <select asp-for="Bridegroom.Genotype" class="form-select">
                            <option value="">Select</option>
                            <option>AA</option><option>AS</option><option>SS</option>
                            <option>AC</option><option>SC</option><option>Other</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Bridegroom.BloodGroup" class="form-label"></label>
                        <select asp-for="Bridegroom.BloodGroup" class="form-select">
                            <option value="">Select</option>
                            <option>A+</option><option>A-</option><option>B+</option><option>B-</option>
                            <option>AB+</option><option>AB-</option><option>O+</option><option>O-</option>
                        </select>
                    </div>

                    <div class="col-12"><hr class="my-1" /></div>

                    <div class="col-md-4">
                        <label asp-for="BridegroomDowerAmountPaidInCash" class="form-label"></label>
                        <input asp-for="BridegroomDowerAmountPaidInCash" class="form-control" type="number" min="0" step="0.01" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BridegroomDowerAmountToBePaid" class="form-label"></label>
                        <input asp-for="BridegroomDowerAmountToBePaid" class="form-control" type="number" min="0" step="0.01" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BridegroomTotalDowerAmount" class="form-label"></label>
                        <input asp-for="BridegroomTotalDowerAmount" class="form-control" type="number" min="0" step="0.01" />
                        <span asp-validation-for="BridegroomTotalDowerAmount" class="text-danger small"></span>
                        <div id="dowerSumHint" class="form-text text-warning"></div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label d-block">Is this your first Nikah?</label>
                        <div class="form-check form-check-inline">
                            <input asp-for="IsFirstNikah" class="form-check-input" type="radio" value="true" id="firstNikahYes" />
                            <label class="form-check-label" for="firstNikahYes">Yes</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input asp-for="IsFirstNikah" class="form-check-input" type="radio" value="false" id="firstNikahNo" />
                            <label class="form-check-label" for="firstNikahNo">No</label>
                        </div>
                    </div>
                    <div class="col-md-6 d-none" id="remarriageGroup">
                        <label class="form-label d-block">If not your first Nikah, which applies?</label>
                        <div class="form-check">
                            <input asp-for="CurrentNikahOrdinal" class="form-check-input remar-opt" type="radio" value="Mathna" id="renMathna" />
                            <label class="form-check-label" for="renMathna">Mathna (second)</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="CurrentNikahOrdinal" class="form-check-input remar-opt" type="radio" value="Thulatha" id="renThulatha" />
                            <label class="form-check-label" for="renThulatha">Thulatha (third)</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="CurrentNikahOrdinal" class="form-check-input remar-opt" type="radio" value="Arbaa" id="renArbaa" />
                            <label class="form-check-label" for="renArbaa">Arba'a (fourth)</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="FormerWifeIsDead" class="form-check-input remar-opt" type="radio" value="true" id="renWidower" />
                            <label class="form-check-label" for="renWidower">Widower</label>
                        </div>
                        <div class="form-check">
                            <input asp-for="HasDivorcedFormerWife" class="form-check-input remar-opt" type="radio" value="true" id="renDivorced" />
                            <label class="form-check-label" for="renDivorced">Divorced (provide evidence below)</label>
                        </div>
                    </div>

                    <div class="col-md-12 d-none" id="talaqEvidenceGroup">
                        <label asp-for="BridegroomDivorceEvidence" class="form-label">
                            Evidence of Talaq (divorce certificate reference / number)
                        </label>
                        <input asp-for="BridegroomDivorceEvidence" class="form-control" />
                        <label asp-for="BridegroomDivorceEvidenceFile" class="form-label mt-2"></label>
                        <input asp-for="BridegroomDivorceEvidenceFile" type="file" class="form-control"
                               accept="@Application.DivorceEvidence.DivorceEvidenceRules.AcceptAttribute" />
                        <span asp-validation-for="BridegroomDivorceEvidenceFile" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label">Will you attend the Nikah in person?</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="CanAttendNikahInPerson" id="attendYes" value="true" />
                            <label class="form-check-label" for="attendYes">Yes</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="CanAttendNikahInPerson" id="attendNo" value="false" />
                            <label class="form-check-label" for="attendNo">No, I will appoint a Wakeel</label>
                        </div>
                    </div>

                    <div class="col-md-6 d-none" id="wakeelNameGroup">
                        <label asp-for="WakeelName" class="form-label">Wakeel's Full Name</label>
                        <input asp-for="WakeelName" class="form-control" />
                    </div>
                    <div class="col-md-6 d-none" id="wakeelTelGroup">
                        <label asp-for="WakeelTel" class="form-label">Wakeel's Phone Number</label>
                        <input asp-for="WakeelTel" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card dashboard-card mb-4" id="brideCard">
            <div class="card-header">
                Bride Information
                <span class="badge rounded-pill text-bg-light ms-2" id="brideBadge">(Partner)</span>
            </div>
            <div class="card-body">
                <p class="text-muted small">Enter your partner's membership number. Their details will be loaded automatically.</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Bride.MembershipNo" class="form-label"></label>
                        <input asp-for="Bride.MembershipNo" class="form-control" id="partnerMembershipNo" />
                        <span asp-validation-for="Bride.MembershipNo" class="text-danger small"></span>
                    </div>
                </div>
                <div id="partnerPreview" class="mt-3 d-none">
                    <div class="alert alert-light border mb-0">
                        <strong>Name:</strong> <span id="pvName"></span><br/>
                        <strong>Date of Birth:</strong> <span id="pvDob"></span><br/>
                        <strong>Address:</strong> <span id="pvAddress"></span><br/>
                        <strong>Phone:</strong> <span id="pvPhone"></span>
                    </div>
                </div>
                <div id="partnerNotFound" class="alert alert-warning d-none mt-3">We couldn't find that membership number. Please check it and try again.</div>
                <div id="partnerBlocked" class="alert alert-danger d-none mt-3"></div>
            </div>
        </div>
    }

    <div class="card dashboard-card mb-4">
        <div class="card-header">Wedding Details</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ProposedNikahDate" class="form-label"></label>
                    <input asp-for="ProposedNikahDate" class="form-control" type="date" />
                    <span asp-validation-for="ProposedNikahDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Venue" class="form-label"></label>
                    <input asp-for="Venue" class="form-control" placeholder="Mosque / Jama'at / venue" />
                    <span asp-validation-for="Venue" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mb-5">
        <button type="submit" class="btn btn-primary">Save &amp; Continue</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Gap 9: live hint when paid in cash + to be paid differs from the total.
        // The server enforces the rule; once the figures agree, this also clears
        // the server's error on the total, because refreshSubmit keeps the submit
        // button disabled while any validation error is visible.
        (function () {
            'use strict';

            var paid = document.getElementById('BridegroomDowerAmountPaidInCash');
            var due = document.getElementById('BridegroomDowerAmountToBePaid');
            var total = document.getElementById('BridegroomTotalDowerAmount');
            var hint = document.getElementById('dowerSumHint');
            if (!paid || !due || !total || !hint) { return; }

            function cents(el) {
                var v = parseFloat(el.value);
                return isNaN(v) ? 0 : Math.round(v * 100);
            }

            function render() {
                var sum = cents(paid) + cents(due);
                if (sum === cents(total)) {
                    hint.textContent = '';
                    total.classList.remove('input-validation-error');
                    var msg = document.querySelector('[data-valmsg-for="' + total.name + '"]');
                    if (msg) {
                        msg.textContent = '';
                        msg.classList.remove('field-validation-error');
                        msg.classList.add('field-validation-valid');
                    }
                } else {
                    hint.textContent = 'Paid in cash + to be paid = ' + (sum / 100).toFixed(2) +
                        ', which does not match the total.';
                }
            }

            [paid, due, total].forEach(function (el) { el.addEventListener('input', render); });
            render();
        })();
    </script>
    <script>
        (function () {
            'use strict';

            var groomRadio = document.getElementById('partyGroom');
            var brideRadio = document.getElementById('partyBride');
            var groomBadge = document.getElementById('groomBadge');
            var brideBadge = document.getElementById('brideBadge');
            var groomCard = document.getElementById('groomCard');
            var brideCard = document.getElementById('brideCard');

            function updateBadges() {
                var isGroom = groomRadio && groomRadio.checked;
                if (groomBadge) { groomBadge.textContent = isGroom ? '(You)' : '(Partner)'; }
                if (brideBadge) { brideBadge.textContent = isGroom ? '(Partner)' : '(You)'; }
            }

            function reorderCards() {
                if (!groomCard || !brideCard || groomCard.parentNode !== brideCard.parentNode) { return; }
                var isGroom = groomRadio && groomRadio.checked;
                var container = groomCard.parentNode;
                if (isGroom) {
                    container.insertBefore(groomCard, brideCard);
                } else {
                    container.insertBefore(brideCard, groomCard);
                }
            }

            function updateLayout() {
                updateBadges();
                reorderCards();
            }

            if (groomRadio) { groomRadio.addEventListener('change', updateLayout); }
            if (brideRadio) { brideRadio.addEventListener('change', updateLayout); }
            updateLayout();

            var partnerAllowed = false;
            var appForm = document.getElementById('appForm');
            var submitBtn = appForm ? appForm.querySelector('button[type="submit"]') : null;
            if (submitBtn) { submitBtn.disabled = true; }

            function refreshSubmit() {
                if (!submitBtn) { return; }
                var errorEls = document.querySelectorAll('.input-validation-error, .field-validation-error, .validation-summary-errors');
                var anyErrorVisible = false;
                for (var i = 0; i < errorEls.length; i++) {
                    if (errorEls[i].offsetParent !== null) { anyErrorVisible = true; break; }
                }
                var clientValid = true;
                if (appForm && window.jQuery && jQuery.fn.validate) {
                    clientValid = jQuery(appForm).validate().checkForm();
                }
                submitBtn.disabled = !(partnerAllowed && !anyErrorVisible && clientValid);
            }

            function setPartnerAllowed(allowed) {
                partnerAllowed = allowed;
                refreshSubmit();
            }

            if (appForm) {
                appForm.addEventListener('input', refreshSubmit);
                appForm.addEventListener('change', refreshSubmit);
            }

            function wirePartnerLookup(membershipId) {
                var input = document.getElementById(membershipId);
                if (!input) { return; }
                input.addEventListener('change', function () {
                    var chandaNo = input.value.trim();
                    var preview = document.getElementById('partnerPreview');
                    var notFound = document.getElementById('partnerNotFound');
                    var blocked = document.getElementById('partnerBlocked');
                    setPartnerAllowed(false);
                    if (!chandaNo) { return; }
                    var partnerIsGroom = !(groomRadio && groomRadio.checked);
                    fetch('/api/members/partner-eligibility/' + encodeURIComponent(chandaNo) + '?partnerIsGroom=' + partnerIsGroom)
                        .then(function (r) { return r.ok ? r.json() : null; })
                        .then(function (m) {
                            if (!m) {
                                if (preview) { preview.classList.add('d-none'); }
                                if (blocked) { blocked.classList.add('d-none'); }
                                if (notFound) { notFound.classList.remove('d-none'); }
                                setPartnerAllowed(false);
                                return;
                            }
                            if (m.blocked) {
                                if (preview) { preview.classList.add('d-none'); }
                                if (notFound) { notFound.classList.add('d-none'); }
                                if (blocked) { blocked.textContent = m.message || ''; blocked.classList.remove('d-none'); }
                                setPartnerAllowed(false);
                                return;
                            }
                            if (notFound) { notFound.classList.add('d-none'); }
                            if (blocked) { blocked.classList.add('d-none'); }
                            if (preview) { preview.classList.remove('d-none'); }
                            function set(id, v) { var el = document.getElementById(id); if (el) { el.textContent = v || ''; } }
                            set('pvName', m.member.fullName);
                            set('pvDob', m.member.dateOfBirth ? m.member.dateOfBirth.slice(0, 10) : '');
                            set('pvAddress', m.member.address);
                            set('pvPhone', m.member.phoneNo);
                            setPartnerAllowed(true);
                        })
                        .catch(function () {
                            setPartnerAllowed(false);
                        });
                });
            }

            wirePartnerLookup('partnerMembershipNo');

            function wireRemarriage() {
                var firstNikahYes = document.getElementById('firstNikahYes');
                var firstNikahNo = document.getElementById('firstNikahNo');
                var group = document.getElementById('remarriageGroup');
                var talaq = document.getElementById('talaqEvidenceGroup');
                if (!firstNikahYes || !firstNikahNo || !group) { return; }
                var options = group.querySelectorAll('.remar-opt');
                var div = document.getElementById('renDivorced');
                // The reference text box and the certificate file (Gap 8).
                var talaqInputs = document.querySelectorAll('#talaqEvidenceGroup input');

                function clearTalaq() {
                    talaqInputs.forEach(function (i) { i.value = ''; });
                }

                function render() {
                    var notFirst = firstNikahNo && firstNikahNo.checked;
                    group.classList.toggle('d-none', !notFirst);
                    talaq.classList.toggle('d-none', !(div && div.checked));
                }

                function onOptionChange(el) {
                    options.forEach(function (o) { if (o !== el) { o.checked = false; } });
                    if (el !== div) { clearTalaq(); }
                    render();
                }

                firstNikahYes.addEventListener('change', function () {
                    options.forEach(function (o) { o.checked = false; });
                    clearTalaq();
                    render();
                });
                firstNikahNo.addEventListener('change', render);
                options.forEach(function (o) { o.addEventListener('change', function () { onOptionChange(o); }); });
                render();
            }
            wireRemarriage();

            function wireBrideEvidence() {
                var sel = document.getElementById('BrideMaritalStatus');
                var khula = document.getElementById('khulaEvidenceGroup');
                if (!sel || !khula) { return; }
                var khulaInputs = khula.querySelectorAll('input');
                function render() { khula.classList.toggle('d-none', sel.value !== 'DivorcedIddatComplete'); }
                sel.addEventListener('change', function () {
                    if (sel.value !== 'DivorcedIddatComplete') { khulaInputs.forEach(function (i) { i.value = ''; }); }
                    render();
                });
                render();
            }
            wireBrideEvidence();

            function wireWakeel() {
                var yes = document.getElementById('attendYes');
                var no = document.getElementById('attendNo');
                var nameGroup = document.getElementById('wakeelNameGroup');
                var telGroup = document.getElementById('wakeelTelGroup');
                if (!yes || !no || !nameGroup || !telGroup) return;
                var nameInput = nameGroup.querySelector('input');
                var telInput = telGroup.querySelector('input');

                function toggle() {
                    var show = no.checked;
                    nameGroup.classList.toggle('d-none', !show);
                    telGroup.classList.toggle('d-none', !show);
                    if (!show) {
                        if (nameInput) { nameInput.value = ''; }
                        if (telInput) { telInput.value = ''; }
                    }
                }

                yes.addEventListener('change', toggle);
                no.addEventListener('change', toggle);
                toggle();
            }
            wireWakeel();

            // Gap 8: picking a new certificate clears the server's error for it,
            // so refreshSubmit (which runs next, on the bubbled change) can
            // re-enable the button.
            function wireEvidenceFiles() {
                document.querySelectorAll('#appForm input[type="file"]').forEach(function (f) {
                    f.addEventListener('change', function () {
                        f.classList.remove('input-validation-error');
                        var msg = document.querySelector('[data-valmsg-for="' + f.name + '"]');
                        if (msg) {
                            msg.textContent = '';
                            msg.classList.remove('field-validation-error');
                            msg.classList.add('field-validation-valid');
                        }
                    });
                });
            }
            wireEvidenceFiles();
        })();
    </script>
}
