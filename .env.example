# Rishta-Nata Management System — local environment configuration.
#
# Copy this file to `.env` and fill in real values:
#   Linux/macOS:      cp .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env
#
# `.env` is git-ignored — never commit real secrets.

# MySQL connection string (overrides ConnectionStrings:DefaultConnection in
# appsettings.json). The `__` double underscore maps to `:` in ASP.NET Core
# configuration, so `ConnectionStrings__DefaultConnection` == `ConnectionStrings:DefaultConnection`.
ConnectionStrings__DefaultConnection=Server=localhost;Port=3306;Database=rishtanatahdb;User=root;Password=your_password;

# Other appsettings.json values can be overridden the same way, e.g.:
#   Api=https://tajneedapi.ahmadiyyanigeria.net/
#   RishtanataSecretary__ChandaNo=to be filled by students of MGQS
#   EmailSettings__SmtpPassword=your-password
